#!/bin/bash

set -eu -o pipefail

# run-compat-matrix - build every (project, variant) cell and record a result.
#
# SYNOPSIS
#   run-compat-matrix
#
# DESCRIPTION
#   Loops over VARIANTS x PROJECTS, running the VARIANT-aware exec_mvn for each
#   cell (so each variant uses its own Maven binary, settings.xml, isolated
#   local repo and JDK -- see common-functions.sh). For every cell it writes a
#   result file with provenance to
#       variants/<variant>/cells/<project>.json
#   The human-readable matrix is rendered separately by bin/compat-render.
#
# ENVIRONMENT
#   VARIANTS       Space-separated variant names. Default: all of variants.txt.
#   PROJECTS       Space-separated project paths. Default: project.list (minus
#                  exclude-projects.txt), as for run-maven.
#   MATRIX_GOALS   Maven goals per cell. Default: "-Prun-its clean verify".
#   MAVEN_PROJECTS_DIR, MAVEN_LRM_SPLIT, flaky/isolated lists: as for run-maven.
#
#   Cells are independent; result classification mirrors the upstream matrix:
#     BUILD SUCCESS -> ok (:white_check_mark:)
#     BUILD FAILURE -> fail (:x:)
#     otherwise     -> warn (:warning:)

dir=$(dirname "${0}")
source "${dir}/common-functions.sh"

# "install", not "verify": components resolve sibling SNAPSHOTs from the
# variant's install prefix, and only an install puts them there.
: "${MATRIX_GOALS:=-P?run-its clean install}"
# Optional cell namespace: cells go to variants/<v>/cells/<MATRIX_NS>/<project>.
# Used by run-compat-4x (MATRIX_NS=_4x) so worktree-built 4.x lines do not
# collide with the manifest cells and render in the 4.x-native section.
: "${MATRIX_NS:=}"

# Variants to run. (Portable: macOS /bin/bash 3.2 has no mapfile.)
if [[ -n "${VARIANTS:-}" ]]; then
  read -r -a matrix_variants <<< "${VARIANTS}"
else
  matrix_variants=()
  while IFS= read -r _name; do
    [[ -n "${_name}" ]] && matrix_variants+=("${_name}")
  done < <(grep -vE '^[[:space:]]*(#|$)' "${root}/variants.txt" 2>/dev/null | awk '{print $1}')
fi

# Projects: PROJECTS is already resolved (env or project.list, minus excludes)
# by common-functions.sh.
read -r -a matrix_projects <<< "${PROJECTS}"

host=$(hostname -s 2>/dev/null || hostname || echo unknown)
opts="${MAVEN_REPO_LOCAL_OPT}"
task="${MATRIX_GOALS// /-}"

total=$(( ${#matrix_variants[@]} * ${#matrix_projects[@]} ))
# exec_mvn prints "(index/noof_projects)"; each row iterates the variants, so
# make the denominator the variant count for natural per-row progress.
noof_projects="${#matrix_variants[@]}"

# Classify a Maven build log -> ok|fail|warn (mirrors the upstream matrix).
classify_log() {
  local log="$1"
  [[ -r "${log}" ]] || { echo warn; return; }
  if grep -q "BUILD SUCCESS" "${log}"; then
    echo ok
  elif grep -qE "BUILD FAILURE|BUILD ERROR" "${log}"; then
    echo fail
  else
    echo warn
  fi
}

# Ensure every requested variant is materialised up-front (sequentially, in the
# main shell) so concurrent rows below never race on creating variants/<v>/.
for variant in "${matrix_variants[@]}"; do
  variant_exists "${variant}" || { echo "SKIP variant '${variant}': not declared in variants.txt" >&2; continue; }
  v_root="$(variant_root "${variant}")"
  if [[ ! -x "${v_root}/maven/bin/mvn" || ! -e "${v_root}/settings.xml" ]]; then
    "${dir}/variant-setup" "${variant}" >/dev/null 2>&1 || true
  fi
done

# Build one component's whole ROW (across all variants, sequentially). This is
# the unit of parallelism: distinct components have distinct source trees, so
# running rows concurrently never has two mvn processes in the same checkout
# (which would collide on target/). Variants within a row stay sequential
# (they share the component's source dir). Concurrent rows may write into the
# same per-variant local repo -- resolver enhanced-LRM locking +
# isolated-m2-projects.txt cover that (same caveat as parallel run-maven).
# Each cell prints its console output as ONE printf line so concurrent rows
# stay intact.
build_component_row() {
  local project="$1"
  local project_dir="${root}/${MAVEN_PROJECTS_DIR}/${project}"
  local head_commit
  head_commit=$(git -C "${project_dir}" rev-parse --short HEAD 2>/dev/null || echo "")
  local variant v_root i=0 tmp cell_log result btime ts cell_file
  for variant in "${matrix_variants[@]}"; do
    variant_exists "${variant}" || continue
    v_root="$(variant_root "${variant}")"
    i=$((i + 1))
    tmp=$(mktemp)
    # Per-call VARIANT (no global export) so parallel rows do not clobber it.
    VARIANT="${variant}" exec_mvn "${project}" "${task}" "${i}" "${opts}" "${MATRIX_GOALS}" >"${tmp}" 2>&1

    cell_log=$(ls -t "${v_root}/logs/${project}"/*.log 2>/dev/null | head -1 || true)
    result=$(classify_log "${cell_log}")
    btime=$(sed -nE 's/.*Total time:[[:space:]]*(.*)/\1/p' "${cell_log}" 2>/dev/null | head -1 || true)
    ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)

    cell_file="${v_root}/cells/${MATRIX_NS:+${MATRIX_NS}/}${project}.json"
    mkdir -p "$(dirname "${cell_file}")"
    jq -n \
      --arg status "${result}" \
      --arg time "${btime}" \
      --arg mvn "$(variant_field "${variant}" 2)" \
      --arg jdk "$(variant_jdk "${variant}")" \
      --arg head "${head_commit}" \
      --arg host "${host}" \
      --arg ts "${ts}" \
      --arg log "${cell_log#"${root}"/}" \
      '{status:$status, time:$time, mvn_version:$mvn, jdk:$jdk,
        head_commit:$head, host:$host, ts:$ts, log:$log}' \
      > "${cell_file}"

    printf '%s\n' "$(cat "${tmp}")"
    rm -f "${tmp}"
  done
}

echo "Matrix: ${#matrix_variants[@]} variant(s) x ${#matrix_projects[@]} project(s) = ${total} cell(s); goals: ${MATRIX_GOALS}; PARALLEL_JOBS=${PARALLEL_JOBS} (over components)"

if [[ "${PARALLEL_JOBS}" -gt 1 ]]; then
  run_parallel "${PARALLEL_JOBS}" build_component_row "${matrix_projects[@]}"
else
  for project in "${matrix_projects[@]}"; do
    build_component_row "${project}"
  done
fi

echo "Matrix complete: ${total} cell(s) written under variants/*/cells/."
echo "Render the table with: ${dir}/compat-render"
