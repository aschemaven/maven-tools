#!/bin/bash

set -eu -o pipefail

# run-compat-matrix - build every (project, variant) cell and record a result.
#
# SYNOPSIS
#   run-compat-matrix
#
# DESCRIPTION
#   Loops over VARIANTS x PROJECTS, running the VARIANT-aware exec_mvn for each
#   cell (so each variant uses its own Maven binary, settings.xml, isolated
#   local repo and JDK -- see common-functions.sh). For every cell it writes a
#   result file with provenance to
#       variants/<variant>/cells/<project>.json
#   The human-readable matrix is rendered separately by bin/compat-render.
#
# ENVIRONMENT
#   VARIANTS       Space-separated variant names. Default: all of variants.txt.
#   PROJECTS       Space-separated project paths. Default: project.list (minus
#                  exclude-projects.txt), as for run-maven.
#   MATRIX_GOALS   Maven goals per cell. Default: "-Prun-its clean verify".
#                  Overridden per project by project-goals.txt -- the core IT
#                  suites need "install", not "verify".
#   MAVEN_PROJECTS_DIR, MAVEN_LRM_SPLIT, flaky/isolated lists: as for run-maven.
#   MATRIX_CELL_TIMEOUT
#                  Seconds a single cell may run (default 10800 = 3h).
#                  Per-project overrides in cell-timeouts.txt; 0 = unlimited.
#   MATRIX_YIELD   "false" disables the cooperative yield. Default "true":
#                  stop between cells once jqa-nightly starts, or once
#                  .compat-matrix.stop appears, and exit 75 (EX_TEMPFAIL).
#
# EXIT STATUS
#   0   every requested cell was attempted
#   75  yielded before completing (nightly running, or stop requested); the
#       caller must NOT treat its change set as consumed
#   other: a hard failure
#
#   Cells are independent; result classification mirrors the upstream matrix:
#     BUILD SUCCESS -> ok (:white_check_mark:)
#     BUILD FAILURE -> fail (:x:)
#     otherwise     -> warn (:warning:)

# No Enhanced-LRM split for matrix cells. Set BEFORE sourcing, because
# common-functions.sh builds MAVEN_OPTS at source time.
#
# The split itself is useful and stays on for the nightly: it keeps our locally
# installed SNAPSHOTs out of the downloaded artefacts in the shared .m2. The
# nightly builds with "clean install" and never activates run-its, so nothing
# there forks a Maven.
#
# The matrix does activate run-its, and that is where it breaks. An IT forks
# its own Maven against a local repository the IT itself owns -- invoker's
# target/local-repo, a checked-in fixture repo, core-it-suite's prepared user
# home -- and outer and inner build must then agree on that repository's
# LAYOUT. They do not, because we exported the split through MAVEN_OPTS:
#   * maven-invoker-plugin REPLACES MAVEN_OPTS when an IT sets mavenOpts
#     (MavenCommandLineBuilder:194), so the fork loses the split while
#     invoker:install wrote split -> "Could not find artifact <plugin>:jar".
#     Ten matrix projects set mavenOpts.
#   * maven-ear-plugin ships a FLAT fixture repository, so a fork that keeps
#     the split looks under m2repo/{installed,cached}/ and finds nothing.
#   * enforcer's corrupted-jar IT poisons cached/releases/ while its cleanup
#     only removes the flat copy, so the poison survives into later ITs.
#   * core-it-suite excludes MAVEN_OPTS from its forks outright.
# Four independent A/B measurements, one variable each: split off turned
# plexus/components/compiler into 12/0, enforcer into 4/0, maven-ear-plugin
# into 5/5 and core/maven-4.0.x (with install) into 1/0.
#
# The variant repositories are per-variant and disposable, so there is nothing
# here for the split to keep apart in the first place. Set MAVEN_LRM_SPLIT=true
# to run a matrix deliberately against split behaviour.
: "${MAVEN_LRM_SPLIT:=false}"
export MAVEN_LRM_SPLIT

dir=$(dirname "${0}")
source "${dir}/common-functions.sh"

# --- single instance ------------------------------------------------------
# A full matrix takes many hours; launchd fires compat-tick every 3600s. With
# no lock each tick stacked another matrix on the running one -- measured on
# godestorm with two concurrent runs and a 5-minute load average of 161.
# compat-tick only ever consulted the nightly's lock, never the matrix's own,
# and nothing stopped a manual run and a tick from colliding either. The lock
# lives here, so it protects against any launcher and not just compat-tick.
#
# mkdir is the atomic test-and-set. The pid file turns a lock left behind by a
# killed run into something detectable: the matrix is unattended, so a stale
# lock would otherwise silence every future tick forever -- the same shape of
# failure as the six days of "FAILED: publish" mails.
lock="${root}/.compat-matrix.lock"
if [[ "${MATRIX_PRINT_ORDER:-false}" == "true" ]]; then
  # A dry run builds nothing, so it neither takes the lock nor waits for one.
  # Without this it would exit 0 and silently print nothing while a round is
  # active -- which is exactly when you want to ask what the order will be.
  lock=""
elif ! mkdir "${lock}" 2>/dev/null; then
  lock_pid=$(cat "${lock}/pid" 2>/dev/null || echo "")
  if [[ -n "${lock_pid}" ]] && kill -0 "${lock_pid}" 2>/dev/null; then
    echo "run-compat-matrix: another run is active (pid ${lock_pid}); exiting" >&2
    exit 0
  fi
  echo "run-compat-matrix: clearing stale ${lock} (pid '${lock_pid:-none}' is gone)" >&2
  rm -rf "${lock}"
  mkdir "${lock}" 2>/dev/null || { echo "run-compat-matrix: cannot acquire ${lock}; exiting" >&2; exit 0; }
fi
if [[ -n "${lock}" ]]; then
  echo "$$" > "${lock}/pid"
fi
# This script forks subshells of itself (visible as sibling run-compat-matrix
# processes in ps). Bash resets traps in a subshell, but the pid check makes
# that guarantee explicit rather than relied upon: only the owner releases.
release_lock() {
  [[ -f "${lock}/pid" ]] || return 0
  [[ "$(cat "${lock}/pid" 2>/dev/null)" == "$$" ]] || return 0
  rm -rf "${lock}"
}
# EXIT alone does not cover a kill: SIGTERM (launchd stopping the job, timeout,
# a plain "kill") would leave the directory behind. The stale-pid check above
# recovers from that on the next run, but releasing here keeps the common case
# clean instead of relying on the recovery path.
trap release_lock EXIT
trap 'release_lock; exit 143' TERM
trap 'release_lock; exit 130' INT

# --- cooperative yield ----------------------------------------------------
# The lock above stops two matrices from overlapping, but not a matrix from
# overlapping the NIGHTLY: compat-tick yields to a running nightly, yet a
# matrix that is already in flight when 21:00 comes round keeps the machine.
# Measured on the night of 2026-10-07: a matrix started 16:55 was still
# running 16 hours later, and the nightly that began at 21:00 needed 11 hours
# for a build stage that takes well under one on an idle machine.
#
# A cell is independent and idempotent, so stopping BETWEEN cells costs
# nothing: the cell file is either written or absent, and the next tick
# rebuilds whatever is missing. That makes yielding the cheap option and
# killing the matrix unnecessary.
#
# .compat-matrix.stop gives the same clean stop on request, which beats "kill"
# -- a killed run leaves a half-written cell and its lock behind.
: "${MATRIX_YIELD:=true}"
yield_marker="${lock}/yielded"
# Asking the process table, not the nightly's lock directory: that lock has no
# pid file, so a nightly killed by a signal leaves it behind and the matrix
# would yield to a job that is not running -- forever.
nightly_active() {
  pgrep -f 'bin/jqa-nightly' >/dev/null 2>&1
}
should_yield() {
  [[ "${MATRIX_YIELD}" == "true" ]] || return 1
  [[ -f "${yield_marker}" ]] && return 0        # decided once, logged once
  if nightly_active; then
    : > "${yield_marker}"
    echo "run-compat-matrix: jqa-nightly is running -- yielding after this cell" >&2
    return 0
  fi
  if [[ -f "${root}/.compat-matrix.stop" ]]; then
    : > "${yield_marker}"
    echo "run-compat-matrix: stop requested via .compat-matrix.stop -- yielding after this cell" >&2
    return 0
  fi
  return 1
}

# One runaway cell must cost one cell, not the window: on 2026-10-07 a single
# cell ran 14.2 hours while nothing else advanced. 3h is deliberately generous
# -- the point is to catch a hang, not to trim honest work -- and projects that
# legitimately need longer are exempted in cell-timeouts.txt (its-3 is).
: "${MATRIX_CELL_TIMEOUT:=10800}"

# -Dspotless.apply.skip for the same reason the nightly passes it: the matrix
# builds the SAME checkouts, so an apply here dirties the tree just as well.
: "${MATRIX_GOALS:=-Prun-its clean verify -Dspotless.apply.skip=true}"
# Optional cell namespace: cells go to variants/<v>/cells/<MATRIX_NS>/<project>.
# Used by run-compat-4x (MATRIX_NS=_4x) so worktree-built 4.x lines do not
# collide with the manifest cells and render in the 4.x-native section.
: "${MATRIX_NS:=}"

# Variants to run. (Portable: macOS /bin/bash 3.2 has no mapfile.)
if [[ -n "${VARIANTS:-}" ]]; then
  read -r -a matrix_variants <<< "${VARIANTS}"
else
  matrix_variants=()
  while IFS= read -r _name; do
    [[ -n "${_name}" ]] && matrix_variants+=("${_name}")
  done < <(grep -vE '^[[:space:]]*(#|$)' "${root}/variants.txt" 2>/dev/null | awk '{print $1}')
fi

# Projects: PROJECTS is already resolved (env or project.list, minus excludes)
# by common-functions.sh.
read -r -a matrix_projects <<< "${PROJECTS}"

host=$(hostname -s 2>/dev/null || hostname || echo unknown)

# Coverage first, then the stalest.
#
# PROJECTS arrives alphabetically -- compat-tick builds its change set with
# comm(1) over sorted lists -- and the alphabet opens with the six most
# expensive components we have. Measured over 268 timed cells: core/maven
# averages 67 min per cell (6.7 h for one row), core/build-cache 50 min, and
# the five costliest components together take 46% of all build time, while the
# median component needs 2.6 min per cell. A round therefore spent every
# window it ever got inside core/ and never reached the tail: on 2026-10-24,
# 64 of 122 rows had never been measured even once, among them 42 of the 44
# plugins that apache/maven-dist-tool reports on. That is not a capacity
# problem. At the median, the whole uncovered backlog is about 17 h of builds.
#
# So order by what the round still owes the table:
#   bucket 0  a cell is missing for some variant -- most missing first, so the
#             rows that add the most coverage per row go first
#   bucket 1  the row is complete -- oldest measurement first, so re-measuring
#             refreshes the stalest data rather than the alphabetically first
#
# Every cell therefore gets measured once before any cell gets measured twice.
# Set MATRIX_NO_REORDER=true to keep the caller's order.
order_projects() {
  local p v cell ts missing oldest bucket key2 tmpf
  tmpf=$(mktemp)
  for p in "${matrix_projects[@]}"; do
    missing=0
    oldest="9999-99-99"
    for v in "${matrix_variants[@]}"; do
      variant_exists "${v}" || continue
      project_allows_variant "${p}" "${v}" || continue
      cell="$(variant_root "${v}")/cells/${MATRIX_NS:+${MATRIX_NS}/}${p}.json"
      if [[ -r "${cell}" ]]; then
        ts=$(sed -nE 's/.*"ts":[[:space:]]*"([0-9-]{10}).*/\1/p' "${cell}" | head -1)
        [[ -n "${ts}" && "${ts}" < "${oldest}" ]] && oldest="${ts}"
      else
        missing=$((missing + 1))
      fi
    done
    if [[ "${missing}" -gt 0 ]]; then
      bucket=0
      # 99-missing so that a bigger gap sorts first under one ascending sort.
      key2=$(printf '%02d' $((99 - missing)))
    else
      bucket=1
      key2="${oldest}"
    fi
    printf '%d\t%s\t%s\n' "${bucket}" "${key2}" "${p}" >> "${tmpf}"
  done
  sort -t"$(printf '\t')" -k1,1n -k2,2 -k3,3 "${tmpf}" | cut -f3
  rm -f "${tmpf}"
}

if [[ "${MATRIX_NO_REORDER:-false}" != "true" && "${#matrix_projects[@]}" -gt 1 ]]; then
  _ordered=()
  while IFS= read -r _p; do
    [[ -n "${_p}" ]] && _ordered+=("${_p}")
  done < <(order_projects)
  [[ "${#_ordered[@]}" -eq "${#matrix_projects[@]}" ]] && matrix_projects=("${_ordered[@]}")
  unset _ordered _p
fi

# What this round would do, without doing it. The order is now the whole point
# of the round, so it has to be inspectable before hours of builds start.
if [[ "${MATRIX_PRINT_ORDER:-false}" == "true" ]]; then
  printf '%s\n' "${matrix_projects[@]}"
  exit 0
fi

# Materialise the locally built Maven distributions before binding variants.
# install-maven-dist only unpacks an apache-maven -bin.zip that a build has
# already left behind, and it skips when the source commit has not moved --
# so this is cheap and idempotent. Doing it here, and not only in the
# nightly, decouples a matrix column from the accident of whether its source
# project happened to be in last night's changed set.
#
# Never fatal: a missing archive means that column is skipped, which the
# matrix now shows instead of silently borrowing the system Maven.
if [[ -x "${dir}/install-maven-dist" ]]; then
  "${dir}/install-maven-dist" || echo "install-maven-dist reported a problem; affected columns will be skipped" >&2
fi
opts="${MAVEN_REPO_LOCAL_OPT}"
task="${MATRIX_GOALS// /-}"

total=$(( ${#matrix_variants[@]} * ${#matrix_projects[@]} ))
# exec_mvn prints "(index/noof_projects)"; each row iterates the variants, so
# make the denominator the variant count for natural per-row progress.
noof_projects="${#matrix_variants[@]}"

# Classify a Maven build log -> ok|fail|warn (mirrors the upstream matrix).
# FALLBACK ONLY -- prefer EXEC_MVN_STATUS. This cannot be trusted on a log
# that embeds nested Maven runs: "grep -q BUILD SUCCESS" matches anywhere, so
# one successful forked build outranks any number of failed ones. Measured on
# 2026-10-08: 58 of 466 cells had both outcomes in their log and every one of
# them was classified "ok" -- maven-invoker-plugin with 8 successes against
# 213 failures among them.
# Per-project goals, overriding MATRIX_GOALS. Lives here and not in exec_mvn
# because this is a matrix concern: the nightly passes its own goals
# ("clean install -fae -Dsurefire.rerunFailingTestsCount=2") and must keep them.
goals_for_project() {
  local project="$1" file="${root}/project-goals.txt" g=""
  if [[ -r "${file}" ]]; then
    g=$(awk -v p="${project}" '$1 == p { $1=""; sub(/^[[:space:]]+/, ""); print; exit }' "${file}" 2>/dev/null)
  fi
  [[ -n "${g}" ]] || g="${MATRIX_GOALS}"
  printf '%s\n' "${g}"
}

classify_log() {
  local log="$1"
  [[ -r "${log}" ]] || { echo warn; return; }
  if grep -q "BUILD SUCCESS" "${log}"; then
    echo ok
  elif grep -qE "BUILD FAILURE|BUILD ERROR" "${log}"; then
    echo fail
  else
    echo warn
  fi
}

# Ensure every requested variant is materialised up-front (sequentially, in the
# main shell) so concurrent rows below never race on creating variants/<v>/.
for variant in "${matrix_variants[@]}"; do
  variant_exists "${variant}" || { echo "SKIP variant '${variant}': not declared in variants.txt" >&2; continue; }
  v_root="$(variant_root "${variant}")"
  if [[ ! -x "${v_root}/maven/bin/mvn" || ! -e "${v_root}/settings.xml" ]]; then
    "${dir}/variant-setup" "${variant}" >/dev/null 2>&1 || true
  fi
done

# Build one component's whole ROW (across all variants, sequentially). This is
# the unit of parallelism: distinct components have distinct source trees, so
# running rows concurrently never has two mvn processes in the same checkout
# (which would collide on target/). Variants within a row stay sequential
# (they share the component's source dir). Concurrent rows may write into the
# same per-variant local repo -- resolver enhanced-LRM locking +
# isolated-m2-projects.txt cover that (same caveat as parallel run-maven).
# Each cell prints its console output as ONE printf line so concurrent rows
# stay intact.

# Record a finished row, so an interrupted round still counts as progress:
# compat-tick folds this file into its baseline at the START of the next tick,
# which is the only place that survives the round being killed outright
# (launchd bootout takes the whole process tree, so nothing after the round
# returns ever runs).
#
# Append of one short line, safe under run_parallel: writes below the pipe
# buffer are not interleaved, and compat-tick folds by key anyway.
record_row_done() {
  if [[ -n "${MATRIX_DONE_LOG:-}" && -n "$2" ]]; then
    printf '%s\t%s\n' "$1" "$2" >> "${MATRIX_DONE_LOG}" || true
  fi
}

build_component_row() {
  local project="$1"
  local cell_goals cell_task
  cell_goals=$(goals_for_project "${project}")
  cell_task="${cell_goals// /-}"
  local project_dir="${root}/${MAVEN_PROJECTS_DIR}/${project}"
  local head_commit
  head_commit=$(git -C "${project_dir}" rev-parse --short HEAD 2>/dev/null || echo "")
  local variant v_root i=0 tmp cell_log result btime ts cell_file

  # No pom.xml means this is not a Maven project, and exec_mvn declines to run
  # it -- but it returns 0 doing so, and the code below then wrote a cell
  # anyway: no log, no duration, and a status left over from whatever ran
  # before. Measured on 2026-10-24, that was 33 cells across six rows, and the
  # status was arbitrary -- the same row read ok, warn or fail depending on the
  # column, which cost us 12 of 40 red cells and 12 green ones that measured
  # nothing. Drop any such cell and skip the row. The row is still recorded as
  # done: there is genuinely nothing here to build, now or next round.
  if [[ ! -r "${project_dir}/pom.xml" ]]; then
    echo "${project}: no pom.xml -- not a Maven project, no cells written"
    for variant in "${matrix_variants[@]}"; do
      variant_exists "${variant}" || continue
      rm -f "$(variant_root "${variant}")/cells/${MATRIX_NS:+${MATRIX_NS}/}${project}.json"
    done
    record_row_done "${project}" "${head_commit}"
    return 0
  fi
  for variant in "${matrix_variants[@]}"; do
    variant_exists "${variant}" || continue
    # A project may be restricted to a subset of variants. Any cell left over
    # from before the restriction is REMOVED rather than left standing: two
    # its-3 cells read "ok" with a 2-second build time while every recorded
    # run of them failed for hours -- stale, and worse than no result.
    if ! project_allows_variant "${project}" "${variant}"; then
      rm -f "$(variant_root "${variant}")/cells/${MATRIX_NS:+${MATRIX_NS}/}${project}.json"
      continue
    fi
    # Checked per cell, not per row: a row of eight variants over
    # core/3.x/its-3 is itself hours of work.
    if should_yield; then return 0; fi
    v_root="$(variant_root "${variant}")"
    i=$((i + 1))
    tmp=$(mktemp)
    # Per-call VARIANT (no global export) so parallel rows do not clobber it.
    # "|| rc=$?" and not a bare call: this runs under errexit, so a non-zero
    # exec_mvn would kill the whole matrix before the next line could look at
    # the code. Measured the hard way -- the run ended silently after the
    # header, without even the closing "Matrix complete".
    rc=0
    VARIANT="${variant}" CELL_TIMEOUT="${MATRIX_CELL_TIMEOUT}" \
      exec_mvn "${project}" "${cell_task}" "${i}" "${opts}" "${cell_goals}" >"${tmp}" 2>&1 || rc=$?

    # rc=2 means exec_mvn refused to run: the variant has no Maven of its own
    # and must not borrow the system one. Nothing was executed, so there is no
    # new log -- and "ls -t | head -1" would happily pick up the log of an
    # EARLIER run and report that stale result as today's. Drop the cell
    # instead; an absent cell renders as "no result yet", which is the truth.
    if [[ "${rc}" -eq 2 ]]; then
      cat "${tmp}"
      rm -f "${tmp}" "${v_root}/cells/${MATRIX_NS:+${MATRIX_NS}/}${project}.json"
      continue
    fi

    cell_log=$(ls -t "${v_root}/logs/${project}"/*.log 2>/dev/null | head -1 || true)
    # A timeout is its own result. classify_log would see neither BUILD SUCCESS
    # nor BUILD FAILURE and call it "warn"/unparseable, which reads like a
    # broken log rather than "we stopped this cell".
    if [[ "${EXEC_MVN_TIMED_OUT:-false}" == "true" ]]; then
      result="timeout"
    elif [[ -n "${EXEC_MVN_STATUS:-}" ]]; then
      # The outer build's exit code is the ground truth; no parsing involved.
      [[ "${EXEC_MVN_STATUS}" -eq 0 ]] && result="ok" || result="fail"
    else
      result=$(classify_log "${cell_log}")
    fi
    # tail, not head: with nested builds the first "Total time" belongs to the
    # first forked IT (2.493 s was recorded for a 7.5-hour cell). The outer
    # reactor's summary is the last one. tail also consumes all input, so no
    # SIGPIPE on the producer.
    btime=$(sed -nE 's/.*Total time:[[:space:]]*(.*)/\1/p' "${cell_log}" 2>/dev/null | tail -1 || true)
    ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)

    cell_file="${v_root}/cells/${MATRIX_NS:+${MATRIX_NS}/}${project}.json"
    mkdir -p "$(dirname "${cell_file}")"
    jq -n \
      --arg status "${result}" \
      --arg time "${btime}" \
      --arg mvn "$(variant_version "${variant}")" \
      --arg jdk "$(variant_jdk "${variant}")" \
      --arg head "${head_commit}" \
      --arg host "${host}" \
      --arg ts "${ts}" \
      --arg log "${cell_log#"${root}"/}" \
      --arg goals "${cell_goals}" \
      '{status:$status, time:$time, mvn_version:$mvn, jdk:$jdk,
        head_commit:$head, host:$host, ts:$ts, log:$log, goals:$goals}' \
      > "${cell_file}"

    printf '%s\n' "$(cat "${tmp}")"
    rm -f "${tmp}"
  done
  # This row is finished. Reached only by falling out of the loop -- the
  # should_yield branch above returns early and is deliberately NOT recorded,
  # because that row is incomplete.
  record_row_done "${project}" "${head_commit}"
}

echo "Matrix: ${#matrix_variants[@]} variant(s) x ${#matrix_projects[@]} project(s) = ${total} cell(s); goals: ${MATRIX_GOALS}; PARALLEL_JOBS=${PARALLEL_JOBS} (over components)"

if [[ "${PARALLEL_JOBS}" -gt 1 ]]; then
  run_parallel "${PARALLEL_JOBS}" build_component_row "${matrix_projects[@]}"
else
  for project in "${matrix_projects[@]}"; do
    if should_yield; then break; fi
    build_component_row "${project}"
  done
fi

# EX_TEMPFAIL, deliberately not 0: compat-tick consumes its change set with
# "mv -f" only after the build round returns, so reporting success here would
# mark the un-built cells as done and they would never be retried. A non-zero
# exit leaves the state stale and the next tick picks up where this stopped.
if [[ -f "${yield_marker}" ]]; then
  echo "Matrix YIELDED before completing; cells not built this round remain missing." >&2
  echo "The pending change set is preserved -- the next tick resumes." >&2
  exit 75
fi

echo "Matrix complete: ${total} cell(s) written under variants/*/cells/."
echo "Render the table with: ${dir}/compat-render"
