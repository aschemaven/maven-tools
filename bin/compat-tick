#!/bin/bash

set -eu -o pipefail

# compat-tick - change-driven compat-matrix refresh (Phase 5).
#
# SYNOPSIS
#   compat-tick
#
# DESCRIPTION
#   One hourly tick (via launchd; see launchd/net.aschemann.maven-compat.plist):
#     1. sync the maven/ source tree (only a real `repo` tree; auto-skipped for
#        test checkouts without .repo)
#     2. detect what changed since the last tick, on TWO axes:
#          components  - a project's source HEAD moved
#          variants    - a variant's Maven changed (version bump / rebuilt distro)
#     3. expand to the cells to rebuild via the two rules:
#          (a) changed component  -> rebuild it across ALL variants
#          (b) changed variant    -> rebuild ALL components with that variant
#     4. invalidate + rebuild only those cells (via run-compat-matrix)
#     5. re-render reports/compat-matrix.md and reports/compat-drift.md
#
#   Role gating (machines.txt / COMPAT_ROLE): a "controller" (daily-work
#   machine) only runs heavy builds inside its nightly window AND when idle; a
#   "runner" builds whenever the tick fires. The cheap brain (sync + detect +
#   render) always runs.
#
# ENVIRONMENT
#   COMPAT_ROLE      controller|runner (else machines.txt; default controller)
#   FORCE_BUILD      true to bypass controller nightly/idle gating
#   NIGHTLY_START    nightly window start hour, local (default 0)
#   NIGHTLY_END      nightly window end hour,   local (default 6)
#   NIGHTLY_LEAD_MIN do not start a round within this many minutes of the
#                    nightly's next launch (default 90; 0 disables)
#   NIGHTLY_PLIST    launchd job that fires the nightly, read for its hour
#   IDLE_MIN_SECONDS minimum HID idle before a controller builds (default 600)
#   COMPAT_SYNC      auto (default; sync only real repo trees) | false
#   MATRIX_GOALS     goals per cell (default "-Prun-its clean verify")
#   PARALLEL_JOBS    forwarded to run-compat-matrix
#   PROJECTS, MAVEN_PROJECTS_DIR, VARIANTS: as for run-compat-matrix.

dir=$(dirname "${0}")
source "${dir}/common-functions.sh"

: "${COMPAT_ROLE:=}"
: "${FORCE_BUILD:=false}"
: "${NIGHTLY_START:=0}"
: "${NIGHTLY_END:=6}"
: "${NIGHTLY_LEAD_MIN:=90}"
: "${NIGHTLY_PLIST:=${HOME}/Library/LaunchAgents/net.aschemann.jqa-nightly.plist}"
: "${IDLE_MIN_SECONDS:=600}"
: "${COMPAT_SYNC:=auto}"
: "${MATRIX_GOALS:=-Prun-its clean verify}"
export PARALLEL_JOBS MATRIX_GOALS

maven_dir="${root}/${MAVEN_PROJECTS_DIR}"
# var/, not reports/: reports/ holds regenerable snapshots and is meant to be
# deletable at any time, but losing this baseline makes every component and
# every variant look changed -- a cold start is 125 x 8 cells of
# "clean verify" with ITs.
state_dir="${root}/var"
mkdir -p "${state_dir}"
heads_state="${state_dir}/tick-heads.tsv"
vars_state="${state_dir}/tick-variants.tsv"
# What the LAST round actually finished, one "component <TAB> head" per row,
# appended by run-compat-matrix as each row completes. Folded into the baseline
# at the start of this tick; see the merge below.
done_log="${state_dir}/tick-done.tsv"
export MATRIX_DONE_LOG="${done_log}"

host=$(hostname -s 2>/dev/null || hostname || echo unknown)

# All declared variants / all resolved projects (space-separated).
all_variants=$(grep -vE '^[[:space:]]*(#|$)' "${root}/variants.txt" 2>/dev/null | awk '{print $1}' | tr '\n' ' ')
all_components="${PROJECTS}"

# --- role -----------------------------------------------------------------
role="${COMPAT_ROLE}"
if [[ -z "${role}" ]]; then
  role=$(awk -v h="${host}" '$1==h {print $2; exit}' "${root}/machines.txt" 2>/dev/null || true)
fi
: "${role:=controller}"

mac_idle_seconds() {
  [[ "$(uname)" == "Darwin" ]] || { echo 999999; return; }   # non-mac: treat as idle
  local ns
  ns=$(ioreg -c IOHIDSystem 2>/dev/null | awk '/HIDIdleTime/ {print $NF; exit}')
  if [[ "${ns}" =~ ^[0-9]+$ ]]; then echo $(( ns / 1000000000 )); else echo 0; fi
}
in_nightly_window() {
  local hr; hr=$((10#$(date +%H)))
  if [[ "${NIGHTLY_START}" -le "${NIGHTLY_END}" ]]; then
    [[ "${hr}" -ge "${NIGHTLY_START}" && "${hr}" -lt "${NIGHTLY_END}" ]]
  else                       # window wraps midnight
    [[ "${hr}" -ge "${NIGHTLY_START}" || "${hr}" -lt "${NIGHTLY_END}" ]]
  fi
}
# The jQAssistant nightly and a matrix build are both all-core, all-disk jobs.
# Nothing coordinated them: on godestorm the nightly occupies 03:00 to roughly
# 15:00, which swallows the whole default build window, and a "runner" would
# start on top of it every hour. Yield to the nightly whatever the role says --
# it holds a lock directory for exactly as long as it runs, so this needs no
# second source of truth. FORCE_BUILD still wins, for a deliberate manual run.
nightly_running() {
  [[ -d "${root}/.jqa-nightly.lock" ]]
}
# Minutes until the nightly's next launch, from the launchd job that actually
# fires it. Returns non-zero when that cannot be read, which DISABLES the lead
# guard rather than guessing an hour.
#
# The installed plist, not launchd/*.template: the template says hour 3 and
# godestorm's installed copy says 21, and it is the installed one that fires.
nightly_due_in() {
  local hour minute now due
  [[ -r "${NIGHTLY_PLIST}" ]] || return 1
  hour=$(/usr/libexec/PlistBuddy -c 'Print :StartCalendarInterval:Hour' \
         "${NIGHTLY_PLIST}" 2>/dev/null) || return 1
  [[ "${hour}" =~ ^[0-9]+$ ]] || return 1
  minute=$(/usr/libexec/PlistBuddy -c 'Print :StartCalendarInterval:Minute' \
           "${NIGHTLY_PLIST}" 2>/dev/null)
  [[ "${minute}" =~ ^[0-9]+$ ]] || minute=0
  now=$(( $((10#$(date +%H))) * 60 + $((10#$(date +%M))) ))
  due=$(( hour * 60 + minute ))
  (( due <= now )) && due=$(( due + 1440 ))
  echo $(( due - now ))
}
# A matrix already in flight must be detected HERE and not only inside
# run-compat-matrix. The change set below is consumed with "mv -f" after the
# build round returns; a matrix that exits 0 because it was locked out would
# look like a completed round and the pending component changes would be
# dropped. Failing should_build() takes the else-branch, which deliberately
# leaves the state stale so the next allowed tick still sees them.
matrix_running() {
  local lp
  [[ -d "${root}/.compat-matrix.lock" ]] || return 1
  lp=$(cat "${root}/.compat-matrix.lock/pid" 2>/dev/null || echo "")
  [[ -n "${lp}" ]] && kill -0 "${lp}" 2>/dev/null
}

# should_build() prints the one reason it declines, and the caller must not add
# a second. Measured 2026-10-27: a tick that correctly reported "jqa-nightly is
# running" went on to print "outside nightly+idle" as well, which reads as a
# second and contradictory explanation for the same decision. decline() returns
# 0 so set -e does not fire on the mark itself; each caller still returns 1.
skip_explained=false
decline() {
  echo "compat-tick: $1"
  skip_explained=true
}

should_build() {
  # Checked before FORCE_BUILD: yielding to the nightly or waiting for an idle
  # window is policy a manual run may override, but two matrices writing the
  # same variants/<v>/cells/<project>.json is not -- that is corruption, plus
  # the dropped-change-set problem above.
  if matrix_running; then
    decline "a compat matrix is still running; skipping the build"
    return 1
  fi
  if ${FORCE_BUILD}; then return 0; fi
  if nightly_running; then
    decline "jqa-nightly is running; skipping the build"
    return 1
  fi
  # Yielding is not enough on its own. run-compat-matrix stands down for the
  # nightly BETWEEN cells, and a single cell may run up to MATRIX_CELL_TIMEOUT
  # -- three hours by default, and plugins/core/surefire really does take 98
  # minutes. So a round begun shortly before the launch still owns the machine
  # well into the night: measured 2026-10-07, a matrix started 16:55 was still
  # going 16 hours later and the nightly's build stage needed 11 hours for
  # work that takes under one on an idle box. Not starting is the only guard
  # that acts in time; the lead must therefore cover a long cell, not a short
  # one.
  local due=""
  if [[ "${NIGHTLY_LEAD_MIN}" -gt 0 ]] && due=$(nightly_due_in) \
     && [[ "${due}" -le "${NIGHTLY_LEAD_MIN}" ]]; then
    decline "jqa-nightly launches in ${due} min (lead ${NIGHTLY_LEAD_MIN}); not starting a round"
    return 1
  fi
  if [[ "${role}" == "runner" ]]; then return 0; fi
  if in_nightly_window && [[ "$(mac_idle_seconds)" -ge "${IDLE_MIN_SECONDS}" ]]; then
    return 0
  fi
  return 1
}

# --- 1. sync (only a real repo tree) --------------------------------------
# Not while something is building in those trees. `repo sync` moves working
# trees, and until now the only guard sat in should_build(): the round was
# correctly skipped while the nightly ran, but this sync went ahead anyway and
# could land new commits in a checkout that jqa-nightly was halfway through
# `clean install`. The build then measures a tree that changed beneath it, and
# the commit recorded for that cell is not the one that was built. Observed
# 2026-10-27 22:57, syncing while the nightly was in core/maven-4.0.x.
# Skipping is cheap: the HEADs stay where they were, so step 2 finds no change
# and the next tick syncs -- and jqa-nightly fetches its own repositories
# regardless, so nothing depends on this sync having run.
if [[ "${COMPAT_SYNC}" == "false" || ! -d "${maven_dir}/.repo" ]]; then
  echo "compat-tick: skip sync (no ${maven_dir}/.repo or COMPAT_SYNC=false)"
elif nightly_running; then
  echo "compat-tick: jqa-nightly is running; skipping the repo sync"
elif matrix_running; then
  echo "compat-tick: a compat matrix is still running; skipping the repo sync"
else
  echo "compat-tick: repo sync in ${maven_dir}"
  ( CDPATH= cd "${maven_dir}" && repo sync -j"$(detect_cpu_count)" ) \
    || echo "WARNING: repo sync failed; continuing with current HEADs" >&2
fi

# --- 2. detect changes ----------------------------------------------------
current_heads="${state_dir}/tick-heads.current"
: > "${current_heads}"
for project in ${all_components}; do
  pd="${maven_dir}/${project}"
  [[ -e "${pd}/.git" ]] || continue
  c=$(git -C "${pd}" rev-parse --short HEAD 2>/dev/null || echo "?")
  printf '%s\t%s\n' "${project}" "${c}" >> "${current_heads}"
done
sort -o "${current_heads}" "${current_heads}"

current_vars="${state_dir}/tick-variants.current"
: > "${current_vars}"
for v in ${all_variants}; do
  fp=$(variant_version "${v}")                       # resolved version string
  m="$(variant_root "${v}")/maven/bin/mvn"
  if [[ -e "${m}" ]]; then
    mt=$(stat -f %m "${m}" 2>/dev/null || stat -c %Y "${m}" 2>/dev/null || echo 0)
    fp="${fp}:${mt}"
  fi
  printf '%s\t%s\n' "${v}" "${fp}" >> "${current_vars}"
done
sort -o "${current_vars}" "${current_vars}"

# Fold in what the previous round finished, BEFORE diffing against it.
#
# The change set used to be consumed by a single "mv -f" after both rounds, so
# a round that did not reach that line counted for nothing: the 2026-10-17
# round built five core projects over ten hours, was cut off at 21:00 by the
# nightly, and the next day started again at the first of those five. The same
# five were rebuilt every day for a week while seventy-five others were never
# reached -- which is what froze most of the table.
#
# Doing it here, from a file on disk, is what makes it survive. Nothing that
# runs after the round can be relied on: a launchd bootout kills the whole
# process tree, and that is also how an operator stops a runaway round.
if [[ -s "${done_log}" ]]; then
  _base="${heads_state}"; [[ -r "${_base}" ]] || _base=/dev/null
  if awk -F'\t' -v donef="${done_log}" '
       FILENAME == donef { d[$1] = $2; next }
       { if ($1 in d) { printf "%s\t%s\n", $1, d[$1]; delete d[$1] } else print }
       END { for (k in d) printf "%s\t%s\n", k, d[k] }
     ' "${done_log}" "${_base}" | sort > "${heads_state}.$$"; then
    mv -f "${heads_state}.$$" "${heads_state}"
    echo "compat-tick: carried over $(wc -l < "${done_log}" | tr -d ' ') component(s) finished by the previous round"
  else
    rm -f "${heads_state}.$$"
  fi
  rm -f "${done_log}"
  unset _base
fi

prev_heads="${heads_state}"; [[ -r "${prev_heads}" ]] || prev_heads=/dev/null
prev_vars="${vars_state}";   [[ -r "${prev_vars}"  ]] || prev_vars=/dev/null
# Print first-column keys whose value changed or is new. Distinguish the two
# files by FILENAME (NOT the NR==FNR trick, which misfires when the prev file
# is empty -- e.g. /dev/null on the first tick -- treating every current row as
# "old" and detecting no change).
diff_keys() {
  awk -F'\t' -v prevf="$1" '
    FILENAME == prevf { old[$1] = $2; next }
    (!($1 in old) || old[$1] != $2) { print $1 }
  ' "$1" "$2" | tr '\n' ' '
}
changed_components=$(diff_keys "${prev_heads}" "${current_heads}")
changed_variants=$(diff_keys "${prev_vars}" "${current_vars}")

echo "compat-tick: role=${role} changed-components=[${changed_components% }] changed-variants=[${changed_variants% }]"

# --- 3+4. rebuild affected cells ------------------------------------------
# No invalidation step any more, deliberately -- this is where the gaps in the
# table came from. It deleted every cell of the batch UP FRONT, so a round over
# forty components blanked 240 cells at once and refilled them over the next
# ten hours; a round that was interrupted left them blank until some later
# round happened to reach them. Measured 2026-10-22 on
# plugins/core/maven-compiler-plugin: five of six cell files gone, one rebuilt.
#
# The reasoning behind it was that a stale result is worse than no result.
# That was true while a cell said only "fail" -- it is not true now that it
# carries "ts" and "head_commit" and the renderers show the measurement date
# (52df101). A dated old result tells the reader what was last measured and
# when; a gap tells them nothing at all, and cannot be told apart from a cell
# that has never been measured. So let run-compat-matrix OVERWRITE each cell
# as it finishes it, and leave the previous measurement standing until then.
#
# The two removals inside run-compat-matrix stay: a variant the project is no
# longer run against, and rc=2 (nothing was executed). Both mean the cell has
# no meaning any more, which is a different thing from "not measured lately".
list_minus() {  # items in $1 that are not in $2
  comm -23 <(printf '%s\n' $1 | sort -u) <(printf '%s\n' $2 | sort -u) | tr '\n' ' '
}

if [[ -z "${changed_components// /}" && -z "${changed_variants// /}" ]]; then
  echo "compat-tick: nothing changed; re-rendering only."
elif should_build; then
  # 75 is EX_TEMPFAIL: run-compat-matrix's cooperative yield, not a failure.
  # It was never handled here. Under errexit the bare calls below aborted the
  # whole tick on it, which did keep the change set -- the contract the matrix
  # documents at its own exit -- but only by accident, and it also skipped the
  # render in step 5 and left launchd recording a failed tick. So every yield
  # froze reports/compat-matrix.md and reports/compat-drift.md until some
  # later round happened to run to the end, and the tick log simply stopped
  # mid-sentence. Handle the code: keep the change set, skip rule (b), and go
  # on to render.
  round_rc=0
  # Rule (a): changed components x all variants.
  if [[ -n "${changed_components// /}" ]]; then
    echo "compat-tick: rule (a) -> [${changed_components% }] x all variants"
    VARIANTS="${all_variants}" PROJECTS="${changed_components}" \
      MAVEN_PROJECTS_DIR="${MAVEN_PROJECTS_DIR}" "${dir}/run-compat-matrix" || round_rc=$?
    # Any other non-zero keeps aborting the tick, exactly as before.
    [[ "${round_rc}" -eq 0 || "${round_rc}" -eq 75 ]] || exit "${round_rc}"
  fi
  # Rule (b): changed variants x all components (minus the overlap already done).
  # Not after a yield: the machine was just handed to the nightly.
  if [[ "${round_rc}" -ne 75 && -n "${changed_variants// /}" ]]; then
    rb=$(list_minus "${all_components}" "${changed_components}")
    if [[ -n "${rb// /}" ]]; then
      echo "compat-tick: rule (b) -> all-minus-changed x [${changed_variants% }]"
      VARIANTS="${changed_variants}" PROJECTS="${rb}" \
        MAVEN_PROJECTS_DIR="${MAVEN_PROJECTS_DIR}" "${dir}/run-compat-matrix" || round_rc=$?
      [[ "${round_rc}" -eq 0 || "${round_rc}" -eq 75 ]] || exit "${round_rc}"
    fi
  fi
  # A round that ran to the end consumes the whole change set, as before. The
  # per-component fold above is for the rounds that do NOT get here.
  #
  # Variants stay all-or-nothing: a variant is only finished once every
  # component has been built against it, so there is no half-way state to
  # record. Rule (b) is also the rare case -- it fires when a Maven version
  # moves, not when a component does.
  if [[ "${round_rc}" -eq 75 ]]; then
    # The rows this round did finish are in ${done_log}; the next tick folds
    # them into the baseline, so the change set shrinks instead of restarting.
    echo "compat-tick: round yielded before completing; change set kept for the next tick"
    rm -f "${current_heads}" "${current_vars}"
  else
    mv -f "${current_heads}" "${heads_state}"
    mv -f "${current_vars}"  "${vars_state}"
    rm -f "${done_log}"
  fi
else
  if [[ "${skip_explained}" != "true" ]]; then
    echo "compat-tick: role '${role}' not building now (outside nightly+idle; FORCE_BUILD=true to override)."
  fi
  echo "compat-tick: would rebuild components=[${changed_components% }] variants=[${changed_variants% }]"
  rm -f "${current_heads}" "${current_vars}"   # leave state stale so next allowed tick still sees the change
fi

# --- 5. render (always; cheap) --------------------------------------------
"${dir}/compat-render" || true
"${dir}/compat-drift" >/dev/null 2>&1 && echo "compat-tick: drift report updated" \
  || echo "compat-tick: drift skipped (offline?)"
