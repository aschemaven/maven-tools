#!/bin/bash

set -eu -o pipefail

# nightly-summary-html - render the compatibility matrix as an HTML table for
#                        the nightly mail.
#
# WHY
#     The plain-text summary listed cell transitions line by line. After an
#     invalidation that is dozens of lines, and a long-standing failure reads
#     exactly like one that broke last night. A table shows the whole matrix at
#     a glance, colour separates the states, and the red deepens with the
#     number of consecutive summaries a cell has been failing.
#
# INPUT
#     var/nightly-summary-cells.tsv, written by bin/nightly-summary:
#       project <TAB> variant <TAB> state <TAB> streak <TAB> changed <TAB> prev
#     Reading the state file rather than re-parsing the rendered table keeps
#     the two parts of the mail from ever disagreeing, and avoids advancing the
#     snapshot twice.
#
#     Rows are ordered by severity, worst first: a failure in a RELEASED
#     variant outranks one in a development line, failures outrank warnings,
#     and all-green rows sink to the bottom. A released version breaking is
#     what users actually hit, so it must not be buried under 120 green rows.
#
# SYNOPSIS
#     nightly-summary-html [<title>]

dir=$(dirname "${0}")
root=$(CDPATH= cd "${dir}/.." && pwd)
cells="${root}/var/nightly-summary-cells.tsv"
title="${1:-Maven compatibility matrix}"

if [[ ! -r "${cells}" ]]; then
  printf '<p>No cell state recorded yet (%s missing).</p>\n' "var/nightly-summary-cells.tsv"
  exit 0
fi

# Which variants are RELEASES. variants.txt gives a literal version for a
# release and "auto@<project>" for a development line (the version is read
# from that project's POM), so the spec itself is the discriminator -- no
# second list to keep in sync.
released=$(awk '
  /^[[:space:]]*(#|$)/ { next }
  $2 !~ /^auto@/ && $2 !~ /SNAPSHOT/ { printf "%s ", $1 }
' "${root}/variants.txt" 2>/dev/null)

# Row order, worst first. Computed before rendering rather than inside the
# renderer: awk here is the BWK awk, which has no asort, and writing rows
# through a "| sort" pipe would interleave with the surrounding HTML.
order=$(mktemp) || exit 1
trap 'rm -f "${order}"' EXIT
awk -F'\t' -v rel="${released}" '
  BEGIN { n = split(rel, r, " "); for (i = 1; i <= n; i++) if (r[i] != "") isrel[r[i]] = 1 }
  {
    proj = $1; var = $2; st = $3
    seen[proj] = 1
    if (st == "fail" || st == "timeout") { if (var in isrel) fr[proj]++; else fd[proj]++ }
    else if (st == "warn") w[proj]++
    else if (st == "ok")   ok[proj]++
  }
  END {
    for (p in seen) {
      # Group first, so warnings can never outrank a failure however many
      # there are, and a row with no data at all sinks below the green ones.
      if (fr[p] || fd[p])   g = 0
      else if (w[p])        g = 1
      else if (ok[p])       g = 2
      else                  g = 3
      printf "%d|%04d|%04d|%04d|%s\t%s\n", g, 9999 - fr[p], 9999 - fd[p], 9999 - w[p], p, p
    }
  }' "${cells}" | sort | cut -f2 > "${order}"

awk -F'\t' -v title="${title}" -v RELNAMES="${released}" -v ORDERFILE="${order}" '
function esc(s) { gsub(/&/, "\\&amp;", s); gsub(/</, "\\&lt;", s); gsub(/>/, "\\&gt;", s); return s }

# Background and foreground per state. Failure deepens with the streak, so a
# cell red for weeks is visibly different from one red since last night.
# One short class per (state, failure depth) instead of an inline style on
# every cell. A full matrix is ~750 cells: inline styling produced 106 KB of
# HTML, and Gmail clips a message at about 102 KB. Classes bring that to a
# fraction. A client that strips <style> still shows the words -- ok, FAIL,
# warn, n/a -- so the table degrades to readable rather than to blank.
function cls(state, streak) {
  if (state == "ok")       return "k"
  if (state == "warn")     return "w"
  if (state == "timeout")  return "t"
  if (state == "excluded") return "n"
  if (state == "none")     return "z"
  if (state == "fail") {
    if (streak >= 10) return "f5"
    if (streak >= 5)  return "f4"
    if (streak >= 3)  return "f3"
    if (streak >= 2)  return "f2"
    return "f1"
  }
  return "z"
}
function mark(state) {
  if (state == "ok")       return "ok"
  if (state == "fail")     return "FAIL"
  if (state == "warn")     return "warn"
  if (state == "timeout")  return "timeout"
  if (state == "excluded") return "n/a"
  if (state == "none")     return "&mdash;"
  return esc(state)
}

# First file is the row order; second is the cell state. Keyed on FILENAME,
# not the NR==FNR trick, which misfires when the first file is empty.
FILENAME == ORDERFILE { porder[++np] = $1; next }

{
  proj = $1; var = $2; st = $3; streak = $4 + 0; ch = $5 + 0; prev = $6
  if (!(var in seenv))  { seenv[var] = 1;  vorder[++nv] = var }
  seenp[proj] = 1
  state[proj, var] = st; strk[proj, var] = streak
  chg[proj, var] = ch;   prv[proj, var] = prev
  if (ch && st != "ok" && st != "excluded" && st != "none" && prev == "ok") regress[++nreg] = proj "\t" var "\t" prev "\t" st
  if (ch && st == "ok" && (prev == "fail" || prev == "warn" || prev == "timeout")) fixed[++nfix] = proj "\t" var "\t" prev "\t" st
  if ((st == "fail" || st == "timeout") && streak >= 3) { longf[++nlong] = streak "\t" proj "\t" var "\t" st }
}

END {
  print "<style>"
  print ".nsum{font-family:-apple-system,Helvetica,Arial,sans-serif;font-size:13px;color:#202124}"
  print ".nsum table{border-collapse:collapse;font-size:12px}"
  print ".nsum th{padding:4px 8px;border-bottom:2px solid #dadce0;text-align:center}"
  print ".nsum th.p{text-align:left}"
  print ".nsum td{padding:3px 8px;text-align:center;border:1px solid #fff}"
  print ".nsum td.p{text-align:left;white-space:nowrap;border-bottom:1px solid #f1f3f4}"
  print ".nsum td.k{background:#e6f4ea;color:#137333}"
  print ".nsum td.w{background:#fef7e0;color:#b06000}"
  print ".nsum td.t{background:#ede7f6;color:#5e35b1}"
  print ".nsum td.n{background:#f1f3f4;color:#80868b}"
  print ".nsum td.z{background:#fff;color:#9aa0a6}"
  print ".nsum td.f1{background:#fce8e6;color:#a50e0e}"
  print ".nsum td.f2{background:#f8c7c3;color:#a50e0e}"
  print ".nsum td.f3{background:#ef9a9a;color:#a50e0e}"
  print ".nsum td.f4{background:#d93025;color:#fff}"
  print ".nsum td.f5{background:#b31412;color:#fff}"
  print ".nsum td.c{outline:2px solid #1a73e8;outline-offset:-2px}"
  print ".nsum .lo{font-size:11px;color:#5f6368}"
  print "</style>"
  print "<div class=\"nsum\">"
  printf "<h2 style=\"font-size:16px;margin:0 0 10px\">%s</h2>\n", esc(title)

  if (nreg) {
    print "<p style=\"margin:0 0 6px\"><b style=\"color:#a50e0e\">Regressions since the previous summary</b></p>"
    print "<ul style=\"margin:0 0 14px 18px;padding:0\">"
    for (i = 1; i <= nreg; i++) {
      split(regress[i], r, "\t")
      printf "<li><code>%s</code> &middot; %s: %s &rarr; <b>%s</b></li>\n", esc(r[1]), esc(r[2]), esc(r[3]), esc(r[4])
    }
    print "</ul>"
  } else {
    print "<p style=\"margin:0 0 14px;color:#137333\">No regressions since the previous summary.</p>"
  }

  if (nfix) {
    print "<p style=\"margin:0 0 6px\"><b style=\"color:#137333\">Fixed</b></p>"
    print "<ul style=\"margin:0 0 14px 18px;padding:0\">"
    for (i = 1; i <= nfix; i++) {
      split(fixed[i], r, "\t")
      printf "<li><code>%s</code> &middot; %s: %s &rarr; <b>%s</b></li>\n", esc(r[1]), esc(r[2]), esc(r[3]), esc(r[4])
    }
    print "</ul>"
  }

  print "<table><tr><th class=\"p\">Project</th>"
  for (j = 1; j <= nv; j++) printf "<th>%s</th>", esc(vorder[j])
  print "</tr>"

  for (i = 1; i <= np; i++) {
    p = porder[i]
    printf "<tr><td class=\"p\"><code>%s</code></td>", esc(p)
    for (j = 1; j <= nv; j++) {
      v = vorder[j]
      if ((p, v) in state) {
        st = state[p, v]; sk = strk[p, v]
        # A changed cell is outlined and carries its previous state, so the
        # table answers "what moved" as well as "what is red".
        c = cls(st, sk)
        if (chg[p, v]) c = c " c"
        tip = chg[p, v] ? sprintf(" (%s&rarr;%s)", esc(prv[p, v]), esc(st)) : ""
        extra = ""
        if ((st == "fail" || st == "timeout") && sk >= 2) extra = sprintf(" %d&times;", sk)
        printf "<td class=\"%s\">%s%s%s</td>", c, mark(st), extra, tip
      } else {
        printf "<td class=\"z\">&mdash;</td>"
      }
    }
    print "</tr>"
  }
  print "</table>"

  if (nlong) {
    print "<p style=\"margin:14px 0 4px;font-size:12px;color:#5f6368\">Failing for three or more consecutive summaries:</p>"
    print "<ul style=\"margin:0 0 0 18px;padding:0;font-size:12px\">"
    for (i = 1; i <= nlong; i++) {
      split(longf[i], r, "\t")
      printf "<li><code>%s</code> &middot; %s &mdash; %s for %s summaries</li>\n", esc(r[2]), esc(r[3]), esc(r[4]), esc(r[1])
    }
    print "</ul>"
  }

  print "<p class=\"lo\" style=\"margin:14px 0 0\">"
  print "Red deepens with the number of consecutive summaries a cell has been failing."
  print "A blue outline marks a cell that changed state since the previous summary;"
  print "<i>n/a</i> is a variant the project is not run against (project-variants.txt)."
  printf "Rows are ordered worst-first: failures in a released variant (%s), then in a development line, then warnings.\n", esc(RELNAMES)
  print "</p>"
  print "</div>"
}
' "${order}" "${cells}"
