#!/bin/bash

set -eu -o pipefail

# install-maven-dist - make built Maven distributions usable as SDKman candidates.
#
# SYNOPSIS
#     install-maven-dist [--force] [<version> ...]
#
# DESCRIPTION
#     Reads maven-dists.txt ("<sdkman-version> <project-path>") and, for each
#     entry, unpacks the distribution archive the project's build produced and
#     links it into ~/.sdkman/candidates/maven/<version>, which is exactly where
#     variant-setup's sdkman_maven_home() looks.
#
#     This is the "future prepare step" variant-setup warns about when a variant
#     names a SNAPSHOT version: SDKman has no such candidate, so the matrix could
#     never bind those columns.
#
#     NO BUILD HAPPENS HERE. The listed projects are among the 125 the nightly
#     builds anyway, and their apache-maven module leaves a -bin.zip behind. This
#     only materialises it.
#
#     Change detection asks the INSTALLED DISTRIBUTION what it is, and compares
#     that against the source HEAD and against the archive's mtime. It does not
#     trust the .source-commit marker beside the distribution, which records the
#     source HEAD at UNPACK time and therefore cannot tell "built from this
#     commit" from "unpacked while the tree happened to be at this commit": an
#     archive rebuilt later at the same HEAD matches the marker and is never
#     taken, so the distribution keeps the commit the EARLIER archive was built
#     from, for ever, while every run reports "unchanged".
#
#     Measured 2026-10-27 on 4.0.0-SNAPSHOT (matrix column m4-40x): marker and
#     HEAD both f116c1f2, a fresh archive sitting in target/ since 15:17 the
#     same day, and "mvn -v" in the installed distribution reporting
#     44add5211 -- 127 commits and six weeks behind. 3.10.1-SNAPSHOT (m3-10x)
#     had drifted the same way, 3d91fd38 against a HEAD of 23da179b. Both
#     columns were measuring a Maven nobody had asked for.
#
#     The marker is still written, as provenance for the reader. Nothing
#     decides anything by it any more.
#
#     The unpacked distribution lives in a stable location under
#     MAVEN_TOOLS_CACHE/dists/ rather than in the project's target/, because a
#     "clean" would otherwise pull the directory out from under the SDKman
#     symlink and leave the matrix pointing at nothing. Unpacking goes to
#     "<dist>.new" and is swapped into place, so an interrupted run cannot leave
#     a half-extracted distribution behind.
#
# OPTIONS
#     --force     re-unpack even when the distribution is already current
#
# ENVIRONMENT
#     MAVEN_PROJECTS_DIR  source tree holding the components (default: maven)
#     MAVEN_TOOLS_CACHE   where dists/ is kept (default: the repo root)

dir=$(dirname "${0}")
root=$(CDPATH= cd "${dir}/.." && pwd)
# shellcheck source=common-functions.sh
source "${dir}/common-functions.sh"

force=false
wanted=""
for a in "$@"; do
  case "${a}" in
    --force) force=true ;;
    -h|--help) sed -n '6,45p' "${0}"; exit 0 ;;
    *) wanted="${wanted} ${a}" ;;
  esac
done

descriptor="${root}/maven-dists.txt"
[[ -r "${descriptor}" ]] || { echo "no ${descriptor}" >&2; exit 1; }

projects_dir="${root}/${MAVEN_PROJECTS_DIR:-maven}"
dists_dir="${MAVEN_TOOLS_CACHE:-${root}}/dists"
lines_dir="${root}/maven-lines"
sdk_dir="${HOME}/.sdkman/candidates/maven"
mkdir -p "${dists_dir}"

stamp() { date '+%F %T'; }

# The commit a built distribution carries, or empty when it reports none
# (master's 4.1.0-SNAPSHOT build does exactly that -- "mvn -v" prints the
# version with no hash at all, so this check is simply unavailable there and
# the archive mtime below is the only guard that applies).
#
# Captured whole and sliced afterwards, never "mvn -v | head -1": the pipe
# closes under Maven and pipefail turns the SIGPIPE into a failure. Same
# defect as the one described at the bottom of this file.
dist_commit() {
  local d="${1}" out
  [[ -x "${d}/bin/mvn" ]] || return 0
  out=$("${d}/bin/mvn" -v 2>/dev/null) || return 0
  printf '%s' "${out}" | sed -n '1s/.*(\([0-9a-f]\{40\}\)).*/\1/p'
}

rc=0

while read -r version project branch rest; do
  [[ -z "${version}" || "${version}" == \#* ]] && continue

  # "auto" means "read the version from the project". Resolved BEFORE the
  # wanted-filter, so a command-line selection names the concrete version the
  # caller sees everywhere else rather than the literal word "auto".
  spec="${version}"
  if ! version=$(resolve_version "${spec}" "${project}" "${branch}"); then
    echo "[$(stamp)] ${project}: cannot resolve version from '${spec}' -- skipped" >&2
    rc=1; continue
  fi

  if [[ -n "${wanted// /}" ]]; then
    case " ${wanted} " in *" ${version} "*) ;; *) continue ;; esac
  fi

  # A third column names a BRANCH. The manifest checks out one branch per
  # project, so a second active line of the same repository (maven-3.9.x next
  # to maven-3.10.x) has no checkout of its own and lives in a worktree that
  # build-maven-lines materialises. Read the archive from there.
  if [[ -n "${branch}" && "${branch}" != "-" ]]; then
    src="${lines_dir}/${version}"
  else
    src="${projects_dir}/${project}"
  fi
  if [[ ! -d "${src}" ]]; then
    if [[ -n "${branch}" && "${branch}" != "-" ]]; then
      echo "[$(stamp)] ${version}: no worktree for branch ${branch} -- run build-maven-lines" >&2
    else
      echo "[$(stamp)] ${version}: source ${project} missing -- skipped" >&2
    fi
    rc=1; continue
  fi

  commit=$(git -C "${src}" rev-parse HEAD 2>/dev/null || echo "")
  dist="${dists_dir}/${version}"
  archive=$(ls -1t "${src}"/apache-maven/target/apache-maven-*-bin.zip 2>/dev/null | head -1 || true)
  installed=$(dist_commit "${dist}")

  # Four states, in the order that makes each one cheap to decide.
  refresh=""
  if [[ "${force}" == "true" ]]; then
    refresh="forced"
  elif [[ ! -x "${dist}/bin/mvn" ]]; then
    refresh="not installed yet"
  elif [[ -n "${archive}" && "${archive}" -nt "${dist}/bin/mvn" ]]; then
    # An archive younger than the installed distribution is a rebuild we have
    # not taken. This condition alone would have caught the m4-40x case, and
    # it needs nothing from the distribution's version string.
    refresh="archive rebuilt $(date -r "${archive}" '+%F %T')"
  elif [[ -n "${commit}" && -n "${installed}" && "${commit}" != "${installed}" ]]; then
    # Behind the source, with no newer archive to fix it: only a build can,
    # and this script deliberately does not build. Say so on every run rather
    # than tolerating it quietly -- quiet tolerance is what cost six weeks.
    echo "[$(stamp)] ${version}: STALE -- distribution is ${installed:0:8}, source is ${commit:0:8}, and no archive is newer. Build ${project} to refresh it." >&2
    rc=1; continue
  elif [[ -z "${installed}" ]]; then
    echo "[$(stamp)] ${version}: current by archive mtime (reports no commit, so it cannot be checked against ${commit:0:8}) -- nothing to do"
    continue
  else
    echo "[$(stamp)] ${version}: unchanged (${installed:0:8}) -- nothing to do"
    continue
  fi
  echo "[$(stamp)] ${version}: refreshing -- ${refresh}"

  if [[ -z "${archive}" ]]; then
    echo "[$(stamp)] ${version}: no -bin.zip under ${project}/apache-maven/target -- build it first" >&2
    rc=1; continue
  fi

  echo "[$(stamp)] ${version}: unpacking $(basename "${archive}") (${commit:0:8})"
  rm -rf "${dist}.new"
  mkdir -p "${dist}.new"
  unzip -q "${archive}" -d "${dist}.new"
  # The archive carries one top-level directory; lift its contents up so that
  # <dist>/bin/mvn is where SDKman expects it.
  inner=$(ls -1d "${dist}.new"/*/ 2>/dev/null | head -1)
  if [[ -n "${inner}" && -x "${inner}/bin/mvn" ]]; then
    mv "${inner}" "${dist}.unpacked"
    rm -rf "${dist}.new"
    mv "${dist}.unpacked" "${dist}.new"
  fi
  [[ -x "${dist}.new/bin/mvn" ]] || { echo "[$(stamp)] ${version}: no bin/mvn in archive" >&2; rm -rf "${dist}.new"; rc=1; continue; }

  [[ -n "${commit}" ]] && echo "${commit}" > "${dist}.new/.source-commit"
  rm -rf "${dist}.prev"
  [[ -d "${dist}" ]] && mv "${dist}" "${dist}.prev"
  mv "${dist}.new" "${dist}"
  rm -rf "${dist}.prev"

  # Link into SDKman. A real directory there is somebody else's install -- leave
  # it alone rather than replacing what a "sdk install" put in place.
  mkdir -p "${sdk_dir}"
  target="${sdk_dir}/${version}"
  if [[ -d "${target}" && ! -L "${target}" ]]; then
    echo "[$(stamp)] ${version}: ${target} is a real directory -- not replacing it" >&2
  else
    ln -sfn "${dist}" "${target}"
  fi

  # Capture first, slice afterwards: "| head -1" closes the pipe after the
  # first line, Maven takes SIGPIPE and pipefail turns that into a failure.
  # Whether it fires depends on how fast Maven writes the rest, which is why
  # one distribution reported fine and the next "installed but 'mvn -v'
  # failed" while the binary was perfectly good. Same defect as the one fixed
  # in install-launchd (grep -q SIGPIPEing launchctl).
  if out=$("${target}/bin/mvn" -v 2>&1); then
    echo "[$(stamp)] ${version}: ${out%%$'\n'*}"
    # The archive itself can be behind the source -- a target/ left over from
    # an earlier commit. Unpacking it is still the right move (it is the
    # newest distribution we have), but the result must not pass for current.
    fresh=$(dist_commit "${dist}")
    if [[ -n "${commit}" && -n "${fresh}" && "${commit}" != "${fresh}" ]]; then
      echo "[$(stamp)] ${version}: the archive was built at ${fresh:0:8}, source is at ${commit:0:8} -- rebuild ${project}" >&2
      rc=1
    fi
  else
    echo "[$(stamp)] ${version}: installed but 'mvn -v' failed" >&2
    rc=1
  fi
done < "${descriptor}"

exit "${rc}"
