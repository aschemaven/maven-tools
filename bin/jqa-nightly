#!/bin/bash

set -u -o pipefail

# jqa-nightly - unattended graph refresh, driven by what actually changed.
#
# SYNOPSIS
#     jqa-nightly [--incremental] [--force] [--dry-run]
#
# DESCRIPTION
#     One scheduled cycle:
#
#       0. sync the repo manifest (apache/maven-sources) -- projects get added,
#          renamed and retired upstream, so the corpus itself must be refreshed
#          before anything is fetched or built
#       1. fetch all repositories (cheap, always) and record their HEADs
#       2. diff against the previous run  ->  list of CHANGED projects
#       3. build   only changed projects  (skipped entirely when nothing moved)
#       4. scan    ALL projects, always -- see below
#       5. github  always -- issues, PRs and comments change without any commit
#       6. analyze always
#       7. on success only: publish the store (stage -> verify -> switch)
#       8. verify the GitHub part against the API's own totalCount
#
#     Written is ALWAYS an offline store, never the served database. A run that
#     fails halfway therefore cannot leave the served graph half-updated, readers
#     never see a partial state, and the previous generation stays available for
#     rollback. Publication is the only step that makes anything visible, and it
#     happens after verification.
#
#     Rationale for "no build if nothing changed": a fetch costs ~1 minute, a
#     build ~50. Most nights only a handful of the repositories move, and
#     building the other ~120 reproduces byte-identical output.
#
#     SCANNING, however, is NOT restricted to changed projects. The graph should
#     reflect the current state of everything, not just of what happened to be
#     rebuilt: a project whose sources did not move can still have new commits
#     on other branches, new tags, or a moved HEAD. Scanning reads the local
#     clone and the caches, so the marginal cost of covering everything is low
#     compared to the risk of a graph that is quietly partial.
#
#     Steps 5 and 6 likewise run unconditionally: issues, pull requests and
#     comments change without any commit at all.
#
# MODES
#   default        rebuild: a NEW dated store, everything scanned into it.
#                  Correct by construction -- nothing deleted upstream survives,
#                  and a fresh store knows no scanned URIs, so the GitHub phase
#                  cannot silently no-op (see below).
#   --incremental  extend the maintained work store instead. Faster for the scan
#                  phase, but the graph drifts and the GitHub phase does nothing.
#                  Useful for a quick partial refresh, not for scheduled runs.
#   --force        build even when no repository changed.
#   --dry-run      report what would happen, change nothing.
#
# WHY A FULL REBUILD EVERY NIGHT
#   Refreshing GitHub data in an EXISTING store is not cheap-but-incremental --
#   it does nothing at all. jQAssistant records scanned URIs and skips them with
#   a DEBUG-level message, ending in BUILD SUCCESS after a few seconds. Making it
#   work would mean deleting the GitHub:Repository nodes first, and the scan then
#   costs its full ~199 minutes anyway; the delete comes on top, and deleting
#   ~100k nodes with their relationships inside Neo4j is far slower than dropping
#   a directory.
#
#   A rebuild therefore costs no more than a corrected incremental run, and it
#   additionally removes drift: branches, tags and pull requests deleted upstream
#   simply never appear. Cost is disk (~5.5 GB per store, see KEEP_STORES) and
#   roughly four to five hours per night, dominated by the GitHub phase.
#
# COVERAGE CHECK
#   After promotion the GitHub subgraph is compared against GitHub's totalCount
#   (jqa-verify-github). A scan can report BUILD SUCCESS while importing almost
#   nothing -- the plugin only fetches items newer than `lastScanAt`, so a cache
#   that started out partial stays partial silently. This is deliberately NOT
#   fatal: the graph is still usable, so the run promotes and notifies rather
#   than discarding a night's work. Set VERIFY_GITHUB=false to skip.
#
# NOTIFICATION
#   On failure: macOS notification (terminal-notifier or osascript) plus, when
#   NIGHTLY_MAIL is set, a mail with the failing stage and log path. A status
#   file is always written to var/nightly-status.txt so a scheduler or a
#   later run can see the outcome without parsing logs.
#
# ENVIRONMENT
#   NIGHTLY_MAIL     recipient for failure mails (optional)
#   WORK_STORE_SUFFIX  suffix of the incremental work store (default -work)
#   SCAN_CHANGED_ONLY  true to scan only changed projects (default false: scan all)
#   PUBLISH            false to skip publication (build only)
#   VERIFY_BOLT        published instance to verify (default bolt://localhost:7688)
#   JQA_MVN_VERSION  Maven for the jQAssistant stages (default 3.9.16)
#   KEEP_STORES      how many dated stores to keep (default 3)

dir=$(dirname "${0}")
root=$(cd "${dir}/.." && pwd)
cd "${root}" || exit 1

: "${JQA_MVN_VERSION:=3.9.16}"
: "${KEEP_STORES:=3}"
: "${NIGHTLY_MAIL:=}"

rebuild=true; force=false; dry=false
for a in "$@"; do
  case "${a}" in
    --incremental) rebuild=false ;;
    --force) force=true ;;
    --dry-run) dry=true ;;
    *) echo "unknown option: ${a}" >&2; exit 1 ;;
  esac
done

# ---------------------------------------------------------------------------
# Keep the pinned JDK major at its newest Temurin build.
#
# Pinning a major without ever refreshing it means drifting further behind
# every month; pinning an exact patch level rots the moment a new one lands.
# This asks SDKman what the newest <major> build from the preferred vendor is
# and installs it quietly if it is missing.
#
# Called ONCE per run from jqa-nightly -- deliberately not from
# common-functions.sh, which is sourced by every sub-script and would turn one
# network call into dozens.
#
# Never fails the run: no network, no SDKman, unknown platform -> return 0 and
# keep using what is installed. Never touches SDKman's "current" symlink, so
# the machine's own default is left alone.
# ---------------------------------------------------------------------------
ensure_latest_jdk() {
  [[ "${JQA_JDK_AUTOUPDATE:-true}" == "true" ]] || return 0
  local major="${JQA_JDK_MAJOR:-25}" vendor="${JQA_JDK_VENDOR:-tem}" plat
  case "$(uname -s)/$(uname -m)" in
    Darwin/arm64)  plat=darwinarm64 ;;
    Darwin/x86_64) plat=darwinx64 ;;
    Linux/x86_64)  plat=linuxx64 ;;
    Linux/arm64|Linux/aarch64) plat=linuxarm64 ;;
    *) return 0 ;;
  esac

  local remote
  remote=$(curl -fsS --max-time 20 \
    "https://api.sdkman.io/2/candidates/java/${plat}/versions/list?current=&installed=" 2>/dev/null \
    | grep -oE "${major}\.[0-9.]+-${vendor}" | sort -V -u | tail -1)
  [[ -z "${remote}" ]] && return 0
  [[ -d "${HOME}/.sdkman/candidates/java/${remote}" ]] && return 0

  echo "[$(stamp)] newer JDK available: ${remote} -- installing"
  # shellcheck disable=SC1091
  source "${HOME}/.sdkman/bin/sdkman-init.sh" 2>/dev/null || return 0
  # "n" declines making it the default; this machine's own current stays put.
  if echo n | sdk install java "${remote}" >/dev/null 2>&1; then
    echo "[$(stamp)] installed ${remote}"
    JQA_JDK_HOME="$(find_java_home "${major}" "${vendor}")"
    export JAVA_HOME="${JQA_JDK_HOME}"
    export PATH="${JAVA_HOME}/bin:${PATH}"
  else
    echo "[$(stamp)] install of ${remote} failed -- keeping $(basename "${JAVA_HOME}")" >&2
  fi
}

state_dir="${root}/var"; mkdir -p "${state_dir}"
heads_prev="${state_dir}/nightly-heads.tsv"
heads_cur="${state_dir}/nightly-heads.current"
status_file="${state_dir}/nightly-status.txt"
stamp() { date '+%F %T'; }

# --- single instance ------------------------------------------------------
lock="${root}/.jqa-nightly.lock"
if ! mkdir "${lock}" 2>/dev/null; then
  echo "[$(stamp)] another jqa-nightly is running (${lock}); exiting" >&2
  exit 0
fi
trap 'rm -rf "${lock}"' EXIT

# --- notification ---------------------------------------------------------
notify_failure() {
  local stage="$1" logdir="$2" errlog="${3-}"
  local title="jQA nightly FAILED: ${stage}"
  local msg="host $(hostname -s), see ${logdir}"
  # The mail goes FIRST. A desktop notification can block forever when no
  # session can display it -- measured on godestorm over ssh, where
  # terminal-notifier hung for 25 minutes, the run never advanced past the
  # first failed stage and the mail that was supposed to report it was never
  # sent. The notifier is a convenience; the mail is the actual channel.
  if [[ -n "${NIGHTLY_MAIL}" ]] && command -v mail >/dev/null 2>&1; then
    # Carry the actual error. A mail with nothing but the stage name cost six
    # days once: the cause ("cannot connect to the Docker daemon") sat in the
    # log the whole time while the mails said only "FAILED: publish".
    {
      printf 'Stage: %s\nHost: %s\nLogs: %s\nTime: %s\n' \
        "${stage}" "$(hostname -s)" "${logdir}" "$(stamp)"
      local src=""
      [[ -n "${errlog}" && -f "${errlog}" ]] && src="${errlog}"
      [[ -z "${src}" && -d "${logdir}" ]] && src=$(ls -1t "${logdir}"/*.log 2>/dev/null | head -1)
      if [[ -n "${src}" && -f "${src}" ]]; then
        printf '\n--- last lines of %s ---\n' "$(basename "${src}")"
        tail -25 "${src}" 2>/dev/null | cut -c1-300
      else
        printf '\n(no log file found to quote)\n'
      fi
    } | mail -s "${title}" "${NIGHTLY_MAIL}" 2>/dev/null || true
  fi
  # Detached: "|| true" catches a failure, never a hang.
  if command -v terminal-notifier >/dev/null 2>&1; then
    ( terminal-notifier -title "${title}" -message "${msg}" >/dev/null 2>&1 & ) || true
  elif command -v osascript >/dev/null 2>&1; then
    ( osascript -e "display notification \"${msg}\" with title \"${title}\"" >/dev/null 2>&1 & ) || true
  fi
}

# One mail per run, whatever the outcome. Previously a successful night said
# nothing at all, so there was no way to tell whether the nightly was doing
# useful work; and a failure said only which stage broke.
notify_summary() {
  local logdir="$1" result="$2"
  [[ -n "${NIGHTLY_MAIL}" ]] || return 0
  command -v mail >/dev/null 2>&1 || return 0
  [[ -x "${dir}/nightly-summary" ]] || return 0
  "${dir}/nightly-summary" "${logdir}" 2>/dev/null \
    | mail -s "jQA nightly ${result}: $(hostname -s)" "${NIGHTLY_MAIL}" 2>/dev/null || true
}

finish() {
  local result="$1" stage="$2" logdir="$3" errlog="${4-}"
  printf '%s\t%s\t%s\t%s\n' "$(stamp)" "${result}" "${stage}" "${logdir}" > "${status_file}"
  if [[ "${result}" != "OK" ]]; then
    notify_failure "${stage}" "${logdir}" "${errlog}"
    notify_summary "${logdir}" "FAILED at ${stage}"
    echo "[$(stamp)] FAILED at ${stage}; logs: ${logdir}" >&2
    exit 1
  fi
  echo "[$(stamp)] OK (${stage}); logs: ${logdir}"
  [[ "${stage}" == "complete" ]] && notify_summary "${logdir}" "OK"
  return 0
}

# --- 0a. Docker ------------------------------------------------------------
# Only the publish stage needs Docker, but it is the LAST stage: a Docker that
# is down costs a full build before anyone finds out. Measured on godestorm,
# where Docker Desktop had been quit: six consecutive nights built a graph for
# twelve hours each and then failed to publish it.
#
# Docker Desktop on macOS is a GUI application, not a daemon -- it does not
# come back on its own, and launchd cannot start it as a service. Asking the
# logged-in session to open it works and is cheap.
ensure_docker() {
  command -v docker >/dev/null 2>&1 || {
    echo "[$(stamp)] no docker command; publish will not work" >&2; return 1; }
  docker info >/dev/null 2>&1 && return 0
  [[ "$(uname -s)" == "Darwin" && -d /Applications/Docker.app ]] || {
    echo "[$(stamp)] docker unreachable and cannot be started here" >&2; return 1; }
  echo "[$(stamp)] docker unreachable; starting Docker Desktop"
  open -a Docker >/dev/null 2>&1 || true
  local i
  for i in $(seq 1 "${DOCKER_WAIT_TRIES:-36}"); do
    sleep 5
    if docker info >/dev/null 2>&1; then
      echo "[$(stamp)] docker up after ~$((i * 5))s"
      return 0
    fi
  done
  echo "[$(stamp)] docker still unreachable after $((${DOCKER_WAIT_TRIES:-36} * 5))s" >&2
  return 1
}
if [[ "${PUBLISH:-true}" == "true" ]] && ! ensure_docker; then
  # Not fatal: the graph is still worth building and can be published later
  # by hand. But say so now, not in twelve hours.
  echo "[$(stamp)] continuing without Docker; the publish stage will fail" >&2
fi

# --- 0. manifest sync -----------------------------------------------------
# The project list is not ours: apache/maven-sources adds, renames and retires
# repositories. Building against a stale manifest silently scans a corpus that
# no longer matches upstream -- and lets projects that were retired months ago
# linger in the graph. Sync first, then read PROJECTS.
# run-maven injects .mvn/develocity.xml and .mvn/extensions.xml into every
# project it builds. `repo sync` then refuses to REMOVE a project ("Cannot
# remove project: uncommitted changes are present") and aborts the whole
# synchronisation as soon as a repository is retired upstream. Observed on
# 2026-09-10: three attempts needed.
#
# Only files that are BYTE-IDENTICAL to the template under develocity/ are
# removed; a project's own .mvn/extensions.xml is left alone. Deliberately over
# the whole tree rather than over PROJECTS: the blocking projects are exactly
# those disappearing from the manifest, so they are no longer in PROJECTS.
clean_injected_mvn() {
  local repo_dir="$1" removed=0 f tmpl own d
  for f in develocity.xml extensions.xml; do
    tmpl="${root}/develocity/${f}"
    [[ -r "${tmpl}" ]] || continue
    while IFS= read -r own; do
      [[ -f "${own}" ]] || continue
      if cmp -s "${own}" "${tmpl}"; then
        rm -f "${own}"; removed=$((removed + 1))
      fi
    done < <(find "${repo_dir}" -type d -name .repo -prune -o -path "*/.mvn/${f}" -print 2>/dev/null)
  done
  # clean up .mvn directories that became empty, they would still block
  while IFS= read -r d; do rmdir "${d}" 2>/dev/null || true; done \
    < <(find "${repo_dir}" -type d -name .repo -prune -o -type d -name .mvn -print 2>/dev/null)
  [[ "${removed}" -gt 0 ]] && echo "[$(stamp)] ${removed} injected .mvn file(s) removed before sync"
  return 0
}

sync_manifest() {
  local repo_dir="${root}/${MAVEN_PROJECTS_DIR:-maven}"
  [[ -d "${repo_dir}/.repo" ]] || { echo "[$(stamp)] no .repo tree -- skipping manifest sync"; return 0; }
  command -v repo >/dev/null 2>&1 || { echo "[$(stamp)] 'repo' not on PATH -- skipping manifest sync" >&2; return 0; }
  clean_injected_mvn "${repo_dir}"
  local before after
  before=$(git -C "${repo_dir}/.repo/manifests" rev-parse --short HEAD 2>/dev/null || echo '?')
  ( cd "${repo_dir}" && repo sync -q --no-clone-bundle -j8 ) || return 1
  after=$(git -C "${repo_dir}/.repo/manifests" rev-parse --short HEAD 2>/dev/null || echo '?')
  if [[ "${before}" != "${after}" ]]; then
    echo "[$(stamp)] manifest ${before} -> ${after}"
    git -C "${repo_dir}/.repo/manifests" diff --stat "${before}..${after}" -- default.xml 2>/dev/null | tail -1
  else
    echo "[$(stamp)] manifest unchanged (${after})"
  fi
  return 0
}

# --- store retention -------------------------------------------------------
# Every run builds a dated store and nothing ever removed the superseded ones.
# Three nights left 12 GB behind, and on a volume at 96 per cent that costs
# scan throughput, not merely space: the same project went from 75 to 880
# seconds once the disk filled up.
#
# A store is disposable as soon as the next one has been published, because
# jqa-publish holds independent copies in its blue/green slots. Keeping two
# leaves one to fall back on.
#
# No "head -n -N" here: that is a GNU extension and this runs on BSD head.
prune_stores() {
  # KEEP_STORES, not a second undocumented JQA_STORE_KEEP: the latter
  # defaulted to 2 while the documented KEEP_STORES says 3, so the
  # setting an operator reads about had no effect here.
  local keep="${KEEP_STORES:-3}" dir="${root}/jqassistant"
  local -a stores=()
  local s
  while IFS= read -r s; do
    [[ -d "${s}" ]] && stores+=("${s}")
  done < <(ls -1d "${dir}"/store-* 2>/dev/null | sort)

  local n=${#stores[@]}
  (( n <= keep )) && return 0

  local i freed=0
  for (( i = 0; i < n - keep; i++ )); do
    s="${stores[$i]}"
    # Never remove the store this run just wrote, whatever the sort order says.
    [[ "${s}" == "${store_dir:-}" ]] && continue
    echo "[$(stamp)] pruning superseded store $(basename "${s}")"
    rm -rf "${s}" && freed=$((freed + 1))
  done
  (( freed > 0 )) && echo "[$(stamp)] pruned ${freed} store(s), keeping ${keep}"
  return 0
}

# --- ssh agent under launchd -----------------------------------------------
# A scheduled run gets no SSH agent in its environment, so every git push over
# SSH dies with "Permission denied (publickey)". That would not fail the run --
# publish_metrics falls back to a local-only commit -- so the data branch would
# simply stop arriving on GitHub without anyone noticing.
#
# macOS keeps the agent socket in the per-user launchd environment. Take it
# from there when the shell did not provide one. Verified: with this socket and
# an otherwise empty environment, github.com authenticates.
if [[ -z "${SSH_AUTH_SOCK:-}" ]] && command -v launchctl >/dev/null 2>&1; then
  _sock=$(launchctl getenv SSH_AUTH_SOCK 2>/dev/null) || _sock=""
  [[ -n "${_sock}" ]] && export SSH_AUTH_SOCK="${_sock}"
  unset _sock
fi

# --- metrics publication ---------------------------------------------------
# The time series are append-only, so tracking them on a code branch dirties
# the worktree after every single run. They live on the orphan branch "data"
# instead: own root, no code history, disposable.
#
# One directory per host. Both machines write here, and keeping their subtrees
# apart means a push never has to merge file contents, only replay commits.
publish_metrics() {
  local wt
  wt=$(git -C "${root}" worktree list --porcelain 2>/dev/null \
       | awk '/^worktree /{p=$2} /^branch refs\/heads\/data$/{print p; exit}')
  if [[ -z "${wt}" || ! -d "${wt}" ]]; then
    echo "[$(stamp)] no 'data' worktree -- metrics stay local"
    return 0
  fi

  local host; host=$(hostname -s)
  mkdir -p "${wt}/${host}"
  cp -f "${root}"/metrics/*.tsv "${wt}/${host}/" 2>/dev/null || return 0

  (
    cd "${wt}" || exit 0
    git add -A "${host}" >/dev/null 2>&1
    if git diff --cached --quiet; then
      echo "[$(stamp)] metrics unchanged -- nothing to publish"
      exit 0
    fi
    git commit -q -m "Update pipeline metrics (${host}, $(date -u '+%Y-%m-%dT%H:%MZ'))" || exit 0
    # Rebase first: the other machine may have appended since the last push.
    git pull --rebase -q origin data >/dev/null 2>&1 || true
    if git push -q origin data >/dev/null 2>&1; then
      echo "[$(stamp)] metrics published to branch 'data'"
    else
      echo "[$(stamp)] metrics committed locally; push to 'data' failed" >&2
    fi
  )
}

# Refresh the pinned JDK major before any stage runs, so the whole run uses
# one JVM rather than switching mid-flight.
ensure_latest_jdk

if [[ "${dry}" == "true" ]]; then
  echo "[dry-run] would run 'repo sync'"
else
  sync_manifest || finish FAILED manifest-sync "${state_dir}"
fi

# --- 1. fetch + record HEADs ---------------------------------------------
# Sourced AFTER the manifest sync: PROJECTS is read from .repo/project.list,
# which the sync may have changed.
# shellcheck source=common-functions.sh
source "${dir}/common-functions.sh"
maven_dir="${root}/${MAVEN_PROJECTS_DIR}"

echo "[$(stamp)] fetching $(echo "${PROJECTS}" | wc -w | tr -d ' ') repositories"
if [[ "${dry}" != "true" ]]; then
  echo "${PROJECTS}" | tr ' ' '\n' | grep -v '^$' \
    | xargs -P 8 -I{} bash -c 'git -C "'"${maven_dir}"'/{}" fetch --all --prune --tags --quiet 2>/dev/null || true'
fi

: > "${heads_cur}"
for p in ${PROJECTS}; do
  [[ -e "${maven_dir}/${p}/.git" ]] || continue
  # All remote HEADs, not just the checked-out branch: the GitHub scan resolves
  # branch HEADs from the graph, so any moved remote ref is relevant.
  h=$(git -C "${maven_dir}/${p}" for-each-ref --format='%(objectname)' refs/remotes 2>/dev/null | sort | shasum | cut -d' ' -f1)
  printf '%s\t%s\n' "${p}" "${h}" >> "${heads_cur}"
done
sort -o "${heads_cur}" "${heads_cur}"

prev="${heads_prev}"; [[ -r "${prev}" ]] || prev=/dev/null
changed=$(awk -F'\t' -v prevf="${prev}" '
  FILENAME == prevf { old[$1] = $2; next }
  (!($1 in old) || old[$1] != $2) { print $1 }
' "${prev}" "${heads_cur}" | tr '\n' ' ')
changed="${changed% }"
n_changed=$(echo "${changed}" | wc -w | tr -d ' ')

# Record the moves WITH their SHAs, here and not later: heads_prev is
# overwritten just before the run ends, so anything downstream that diffs the
# two files again would see no difference at all.
changed_file="${state_dir}/nightly-changed.tsv"
awk -F'\t' -v prevf="${prev}" '
  FILENAME == prevf { old[$1] = $2; next }
  !($1 in old)      { printf "%s\t%s\t%s\n", $1, "-", $2; next }
  old[$1] != $2     { printf "%s\t%s\t%s\n", $1, old[$1], $2 }
' "${prev}" "${heads_cur}" > "${changed_file}" 2>/dev/null || : > "${changed_file}"

echo "[$(stamp)] changed repositories: ${n_changed}"

# Projects that must be built whatever the change detection says, because
# something downstream depends on their build OUTPUT rather than on the graph.
# The Maven core lines are the base of four matrix columns, and
# install-maven-dist only unpacks -- it cannot conjure an archive that no
# build produced.
always_build=$(read_project_list_file "${root}/always-build-projects.txt")
if [[ -n "${always_build}" ]]; then
  for _p in ${always_build}; do
    case " ${changed} " in *" ${_p} "*) ;; *) changed="${changed:+${changed} }${_p}" ;; esac
  done
  unset _p
  n_changed=$(echo "${changed}" | wc -w | tr -d ' ')
  echo "[$(stamp)] always-build adds up to $(echo "${always_build}" | wc -w | tr -d ' ') project(s); building ${n_changed}"
fi

[[ "${n_changed}" -gt 0 && "${n_changed}" -le 15 ]] && echo "    ${changed}"

# A weekly full build, whether or not anything moved upstream. Building only
# what changed is right for the graph, but it never re-exercises the other
# ~90 projects, so a regression that comes from the TOOLS or the ENVIRONMENT
# -- a new Maven, a JDK patch, a plugin resolving differently -- stays
# invisible until the day that project happens to move on its own. One full
# pass a week puts a floor under that.
full_marker="${state_dir}/last-full-build"
: "${FULL_BUILD_DAYS:=7}"
if [[ "${force}" != "true" && "${FULL_BUILD_DAYS}" -gt 0 ]]; then
  _age_days=99999
  if [[ -r "${full_marker}" ]]; then
    _last=$(cat "${full_marker}" 2>/dev/null || echo 0)
    [[ "${_last}" =~ ^[0-9]+$ ]] && _age_days=$(( ( $(date +%s) - _last ) / 86400 ))
  fi
  if [[ "${_age_days}" -ge "${FULL_BUILD_DAYS}" ]]; then
    if [[ -r "${full_marker}" ]]; then
      echo "[$(stamp)] last full build was ${_age_days} day(s) ago; building everything"
    else
      echo "[$(stamp)] no full build on record; building everything"
    fi
    force=true
  fi
  unset _age_days _last
fi

if [[ "${dry}" == "true" ]]; then
  echo "[dry-run] mode=$([[ ${rebuild} == true ]] && echo rebuild || echo incremental) force=${force}; would build: $([[ ${force} == true ]] && echo '<all projects>' || echo "${changed:-<nothing>}")"
  exit 0
fi

# --- store selection ------------------------------------------------------
# Two deliberately different targets:
#
#   incremental -> writes DIRECTLY into the served Neo4j over Bolt. Small,
#                  frequent updates become visible immediately, there is no
#                  5 GB copy per run, and the coverage check afterwards sees
#                  exactly what was just written.
#   rebuild     -> writes a NEW embedded store and promotes it atomically.
#                  Neo4j Community serves a single database, so rebuilding in
#                  place would leave the served graph incomplete for hours;
#                  building beside it and swapping keeps the old one queryable
#                  until the moment it is replaced.
# Both modes write to an OFFLINE store. The only difference is whether the
# maintained work store is extended incrementally or a new one is built.
unset JQA_STORE_URI
if [[ "${rebuild}" == "true" ]]; then
  export JQA_STORE_SUFFIX="-$(date '+%Y%m%d-%H%M')"
  scan_projects=""                     # empty -> all projects
  echo "[$(stamp)] rebuild into jqassistant/store${JQA_STORE_SUFFIX}"
else
  export JQA_STORE_SUFFIX="${WORK_STORE_SUFFIX:--work}"
  [[ -d "${root}/jqassistant/store${JQA_STORE_SUFFIX}" ]] \
    || echo "[$(stamp)] work store does not exist yet -- first run builds it from scratch"
  # Deliberately NOT "${changed}": scan everything so the graph is current.
  # SCAN_CHANGED_ONLY=true restores the narrow behaviour for a quick run.
  if [[ "${SCAN_CHANGED_ONLY:-false}" == "true" ]]; then
    scan_projects="${changed}"
    echo "[$(stamp)] incremental into jqassistant/store${JQA_STORE_SUFFIX} (only changed projects)"
  else
    scan_projects=""
    echo "[$(stamp)] incremental into jqassistant/store${JQA_STORE_SUFFIX} (scanning all projects)"
  fi
fi
store_dir="${root}/jqassistant/store${JQA_STORE_SUFFIX}"

# Keep the store out of Time Machine. A 4 GB directory written afresh every
# night is snapshotted hourly, which is what turned a two-hour run into twelve
# and filled the volume from 116 GB free to 43 in four days.
#
# Done here rather than left to the tm-exclusions sweep: that sweep reports
# "added=0" for these paths even though its own find predicate matches them,
# and a nightly must not depend on an external job for its own throughput.
# The exclusion is path-based and dies with the directory, which is correct --
# each run excludes the store it just created.
exclude_from_backup() {
  command -v tmutil >/dev/null 2>&1 || return 0
  mkdir -p "$1" 2>/dev/null || return 0
  tmutil addexclusion "$1" 2>/dev/null \
    && echo "[$(stamp)] excluded from Time Machine: $(basename "$1")" \
    || echo "[$(stamp)] could not exclude $(basename "$1") from Time Machine" >&2
  return 0
}
exclude_from_backup "${store_dir}"

# --- 1b. seed the fresh store with the JDK graph --------------------------
# jQAssistant resolves types per artifact, so a project that references
# java.lang.RuntimeException gets its own placeholder with no EXTENDS of its
# own; on the published graph that one type existed 366 times, none linked.
# Every inheritance question therefore died at the JDK boundary.
#
# The JDK is scanned ONCE per JDK version into jqassistant/base-jdk-<version>
# (about a minute, 338 MB) and copied in here, so a rebuild starts from a
# store that already knows java.lang.* instead of paying the scan nightly.
# The jdk:* concepts in jqassistant/rules/jdk-type-resolution.xml then wire
# each artifact's placeholders into that hierarchy during analyze.
#
# A missing base is a degradation, not a failure: the graph is still complete,
# only inheritance chains stop where they always used to.
if [[ "${rebuild}" == true ]]; then
  # JQA_STORE_SUFFIX is exported above, and scan-jdk honours it -- which would
  # make it scan the JDK straight into tonight's store instead of handing back
  # the reusable base. Measured: 60s per run instead of a 0.6s copy, plus a
  # misleading "no JDK base store" because the captured output is then Maven's,
  # not a path. Unset it for this one call.
  jdk_base="$(env -u JQA_STORE_SUFFIX ./bin/scan-jdk 2>/dev/null | tail -1)"
  if [[ -n "${jdk_base}" && -d "${jdk_base}" ]]; then
    mkdir -p "${store_dir}"
    if rsync -a --exclude .complete "${jdk_base}/" "${store_dir}/"; then
      echo "[$(stamp)] seeded store from $(basename "${jdk_base}")"
    else
      echo "[$(stamp)] could not seed from $(basename "${jdk_base}")" >&2
    fi
  else
    echo "[$(stamp)] no JDK base store; type hierarchies will stop at the JDK boundary" >&2
  fi
fi

logdir=""
run_stage() {                          # run_stage <stage> [PROJECTS]
  local stage="$1"; local projects="${2-}"
  local out
  if [[ -n "${projects}" ]]; then
    PROJECTS="${projects}" JQA_MVN_VERSION="${JQA_MVN_VERSION}" ./bin/run-jqa-cycle "${stage}" >/dev/null
  else
    JQA_MVN_VERSION="${JQA_MVN_VERSION}" ./bin/run-jqa-cycle "${stage}" >/dev/null
  fi
  out=$(ls -1dt logs/jqa-cycle-* | head -1)
  logdir="${out}"
  grep -qE "END +${stage} +rc=0" "${out}/timing.txt" 2>/dev/null
}

# --- 2. build (only what moved) ------------------------------------------
# Building and scanning are decided independently.
#
#   build  only what changed. A rebuild of the STORE does not imply a rebuild of
#          the ARTEFACTS: the scan reads target/, which survives between runs.
#          Tying the two together would rebuild all ~125 projects every night for
#          no gain.
#   scan   everything, always (see the store selection above).
if [[ "${n_changed}" -eq 0 && "${force}" != "true" ]]; then
  echo "[$(stamp)] nothing changed -- skipping build"
else
  build_projects="${changed}"
  [[ "${force}" == "true" ]] && build_projects=""
  run_stage build "${build_projects}" || finish FAILED build "${logdir}"
  # Record the full pass only after it succeeded, so a broken week is retried
  # tomorrow instead of being marked done.
  [[ "${force}" == "true" ]] && date +%s > "${full_marker}"
  # The build leaves an apache-maven -bin.zip behind for the Maven source
  # projects; materialise it so the compatibility matrix binds a current
  # distribution. Unpacks only when the source commit moved, and never
  # fails the run -- a missing archive is the matrix's problem, not the
  # graph's.
  ./bin/install-maven-dist || true
fi
run_stage scan "${scan_projects}" || finish FAILED scan "${logdir}"

# --- 3. GitHub + analyze always ------------------------------------------
run_stage github  || finish FAILED github  "${logdir}"
run_stage analyze || finish FAILED analyze "${logdir}"

# --- 4. publish -----------------------------------------------------------
# stage -> verify -> switch. Only the switch makes the new state visible; if a
# step fails, the previous version stays online unchanged.
# Prune BEFORE publishing, not after. "finish" exits the script, so a failed
# publish skipped every cleanup below it -- including a second loop here that
# had been written to be independent of publication and was simply unreachable.
# Measured on godestorm: six nights of 3.5 GB stores accumulated to eight
# stores and filled the volume to 99%, at which point publish would have
# failed for a second, unrelated reason.
#
# Safe in this order because the dated stores are not what is being served:
# jqa-publish holds its own copies in the blue/green slots, and prune_stores
# never touches the store this run just wrote.
prune_stores

if [[ "${PUBLISH:-true}" == "true" ]]; then
  # Keep the output: jqa-publish writes its diagnosis to stdout/stderr, which
  # does not land in the stage log directory, so the failure mail had nothing
  # to quote.
  publish_log="${root}/logs/publish-$(date '+%y%m%d-%H%M%S').log"
  if ! ./bin/jqa-publish run "${store_dir}" 2>&1 | tee "${publish_log}"; then
    finish FAILED publish "${logdir}" "${publish_log}"
  fi
fi

# --- 5. verify coverage against the GitHub API ----------------------------
# Runs against the published database -- normally the store just promoted, and
# with --incremental the database that was just written.
if [[ "${VERIFY_GITHUB:-true}" == "true" ]]; then
  echo "[$(stamp)] verifying GitHub coverage against the API"
  if ./bin/jqa-verify-github --bolt "${VERIFY_BOLT:-bolt://localhost:7688}" > "${state_dir}/github-coverage.txt" 2>&1; then
    grep -E '^(issues|prs|milestones|releases)' "${state_dir}/github-coverage.txt" || true
  else
    rc=$?
    if [[ "${rc}" -eq 1 ]]; then
      echo "[$(stamp)] WARNING: repositories under-covered -- see ${state_dir}/github-coverage.txt" >&2
      sed -n '/UNDER-COVERED/,$p' "${state_dir}/github-coverage.txt" | head -12
      notify_failure "github-coverage" "${state_dir}/github-coverage.txt"
    else
      echo "[$(stamp)] coverage check could not run (rc=${rc}) -- skipped" >&2
    fi
  fi
fi

cp -f "${heads_cur}" "${heads_prev}"
./bin/jqa-timings collect >/dev/null 2>&1 || true
publish_metrics
finish OK complete "${logdir}"
