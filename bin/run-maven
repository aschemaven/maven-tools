#!/bin/bash

set -eu -o pipefail

if [[ "${ACTIONS_RUNNER_DEBUG:-}" == "true" ]]; then
  set -vx
fi

# This script executes Maven goals for multiple projects with specific options and configurations.
#
# SYNOPSIS
#   run-maven [--clean] [--retry N] [Maven goals...]
#
# DESCRIPTION
#   This script automates the execution of Maven goals for a list of projects defined
#   in an environment variable `PROJECTS`. It ensures that Maven uses a specific local
#   repository directory and applies provided goals across all projects sequentially.
#
#   Before running the goals, the script checks each project for workspace pollution
#   (e.g. leftover jqassistant/store directories, untracked root-level files that would
#   trip Apache RAT). By default it aborts if any is found. Pass --clean as the first
#   argument to remove the pollution and continue.
#
#   --retry N applies to ALL failed projects this run (ad-hoc mode). Without --retry,
#   projects listed in flaky-projects.txt / FLAKY_PROJECTS still get a default of 2
#   automatic retries each.
#
#   The script reads common functions from the `common-functions.sh` file located in the
#   same directory as the script itself.
#
# USAGE EXAMPLE
#   run-maven clean install
#   run-maven --clean clean install
#   run-maven --retry 3 clean verify
#
# ENVIRONMENT VARIABLES
#   PROJECTS   A space-separated list of project paths or identifiers for which Maven
#              goals will be executed.
#          Default: All projects listed in .repo/project.list
#
# NOTES
#   - The script requires the sourced `common-functions.sh` file to define the `exec_mvn`
#     function, which handles the Maven execution logic.
#   - The script uses the `root` variable (set in common-functions.sh) to define the local
#     Maven repository directory.
#   - The script uses the `opts` variable to define additional Maven options, such as the
#     local repository directory.

#prog=$(basename $0)
dir=$(dirname "${0}")
source "${dir}/common-functions.sh"

clean_workspace=false
retry_cli=""
while [[ "${1:-}" == --* ]]; do
  case "$1" in
    --clean)
      clean_workspace=true
      shift
      ;;
    --retry)
      shift
      retry_cli="${1:-}"
      if [[ ! "${retry_cli}" =~ ^[0-9]+$ ]]; then
        echo "ERROR: --retry requires a non-negative integer argument" >&2
        exit 2
      fi
      shift
      ;;
    *)
      echo "ERROR: unknown option '${1}'" >&2
      exit 2
      ;;
  esac
done
export RETRY_CLI="${retry_cli}"

check_workspaces "${clean_workspace}"

opts="${MAVEN_REPO_LOCAL_OPT}"

goals="${*}"

tmpdir=$(mktemp -d -t "maven-$$.XXXXXX")
trap '/bin/rm -rf "${tmpdir}"' EXIT

export TMPDIR="${tmpdir}"

mkdir -p "${root}/logs"
overall_log="${root}/logs/run-maven-${goals// /-}-$$.log"

# Individual build failures are handled by exec_mvn (logged + reported).
# The loop must not propagate those failures to the script exit code.
set +e
{
  for project in ${PROJECTS}; do
    counter=$((counter + 1))
    exec_mvn "${project}" "${goals// /-}" "${counter}" "${opts}" "${goals}"
  done
} 2>&1 | tee "${overall_log}"
set -e

# Summary -- parsed from overall_log so it reflects the final emitted state
# (the for-loop runs in a pipe subshell, so per-project state doesn't
# survive into here). Appended to the overall log as well, so the log
# self-contains the summary.
{
  total_succ=$(grep -cE "'\) succeeded" "${overall_log}" || true)
  total_fail=$(grep -cE "'\) failed" "${overall_log}" || true)
  succ_w_retry=$(grep -cE "'\) succeeded after [0-9]+ retr" "${overall_log}" || true)
  fail_w_retry=$(grep -cE "'\) failed after [0-9]+ retr" "${overall_log}" || true)
  non_maven=$(grep -cE 'is not a Maven project' "${overall_log}" || true)
  total_built=$((total_succ + total_fail))
  echo ""
  echo "================ run-maven summary ================"
  echo "Goals:     ${goals}"
  echo "Projects:  ${total_built} built, ${non_maven} non-Maven skipped"
  echo "Succeeded: ${total_succ}  (${succ_w_retry} after retry)"
  echo "Failed:    ${total_fail}  (${fail_w_retry} after retry)"
  if [[ ${total_fail} -gt 0 ]]; then
    echo ""
    echo "Failures:"
    # Subshell with relaxed flags so grep's non-match exit (1) doesn't
    # bail us out via pipefail/set -e.
    (
      set +e +o pipefail
      grep -E "'\) failed" "${overall_log}" | while IFS= read -r line; do
        proj=$(printf '%s' "${line}" | sed -E 's/^([^ ]+) .*/\1/')
        logpath=$(printf '%s' "${line}" | sed -E "s/.*\(logs: '([^']+)'\).*/\1/")
        retry_tag=$(printf '%s' "${line}" | grep -oE 'after [0-9]+ retr(y|ies)' | head -1)
        [[ -n "${retry_tag}" ]] && retry_tag=" (${retry_tag})"
        printf '  %s%s\n      %s\n' "${proj}" "${retry_tag}" "${logpath}"
      done
    )
  fi
  echo "==================================================="
} 2>&1 | tee -a "${overall_log}"
