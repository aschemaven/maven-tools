#!/bin/bash

set -eu -o pipefail

# compat-render - render reports/compat-matrix.md from every variant's cells/.
#
# SYNOPSIS
#   compat-render
#
# DESCRIPTION
#   Reads variants/<variant>/cells/<project>.json for every variant declared in
#   variants.txt and emits a Markdown matrix (rows = projects, columns =
#   variants) to reports/compat-matrix.md. Pure render step: no builds, reads
#   only result files, so it can run on any machine over merged/synced cells.
#
#   Icons mirror the upstream plugins-maven4.md matrix:
#     ok -> :white_check_mark:   fail -> :x:   warn -> :warning:   missing -> —

# Resolve the tools-repo root without sourcing common-functions (no side
# effects, no project.list read needed here). readlink -f (not cd/pwd) so a
# set CDPATH in the environment can't pollute the value.
dir=$(dirname "${0}")
root=$(readlink -f "${dir}/..")

command -v jq >/dev/null 2>&1 || { echo "ERROR: jq is required for compat-render" >&2; exit 1; }

mkdir -p "${root}/reports"
out="${root}/reports/compat-matrix.md"

# Variants in declared order. (Portable: macOS /bin/bash 3.2 has no mapfile.)
variants=()
while IFS= read -r _name; do
  [[ -n "${_name}" ]] && variants+=("${_name}")
done < <(grep -vE '^[[:space:]]*(#|$)' "${root}/variants.txt" 2>/dev/null | awk '{print $1}')
if [[ ${#variants[@]} -eq 0 ]]; then
  echo "No variants declared in variants.txt" >&2
  exit 1
fi

# Union of all projects that have at least one cell, sorted.
projects=()
while IFS= read -r _proj; do
  [[ -n "${_proj}" ]] && projects+=("${_proj}")
done < <(
  for v in "${variants[@]}"; do
    d="${root}/variants/${v}/cells"
    [[ -d "${d}" ]] && find "${d}" -name '*.json' 2>/dev/null \
      | sed -E "s#^${d}/##; s#\.json\$##"
  done | sort -u
)

icon() {
  case "$1" in
    ok)   echo ':white_check_mark:' ;;
    fail) echo ':x:' ;;
    warn) echo ':warning:' ;;
    *)    echo '—' ;;
  esac
}

# A 4.x-native row is a project on a "-4" line: plugins/core-4/*,
# plugins/packaging-4/*, shared-4/* (already checked out by the repo manifest),
# or a cell written under the worktree namespace _4x/ (Deliverable 3 worktrees
# for plugins that have no -4/ manifest entry).
is_fourx() { [[ "$1" =~ (^|/)[A-Za-z0-9_]*-4/ || "$1" == _4x/* ]]; }

# Emit one section: "## <title>" then a matrix table for the given project list.
emit_table() {
  local title="$1" plist="$2" p v f st tm
  echo "## ${title}"
  echo
  if [[ -z "${plist// /}" ]]; then
    echo "_none_"
    echo
    return
  fi
  printf '| Project |'
  for v in "${variants[@]}"; do printf ' %s |' "${v}"; done
  printf '\n'
  printf '|---|'
  for _ in "${variants[@]}"; do printf '%s' '---|'; done
  printf '\n'
  for p in ${plist}; do
    printf '| `%s` |' "${p#_4x/}"
    for v in "${variants[@]}"; do
      f="${root}/variants/${v}/cells/${p}.json"
      if [[ -r "${f}" ]]; then
        st=$(jq -r '.status // "warn"' "${f}")
        tm=$(jq -r '.time // ""' "${f}")
        printf ' %s %s |' "$(icon "${st}")" "${tm}"
      else
        printf ' %s |' "$(icon missing)"
      fi
    done
    printf '\n'
  done
  echo
}

# Bucket projects into the manifest (3.x) section and the 4.x-native section.
main_list="" ; fourx_list=""
for p in "${projects[@]}"; do
  if is_fourx "${p}"; then fourx_list="${fourx_list} ${p}"; else main_list="${main_list} ${p}"; fi
done

{
  echo "# Maven Compatibility Matrix"
  echo
  echo "_Generated $(date -u +%Y-%m-%dT%H:%M:%SZ) on $(hostname -s 2>/dev/null || hostname || echo unknown)._"
  echo
  if [[ ${#projects[@]} -eq 0 ]]; then
    echo "_No cells yet. Run \`bin/run-compat-matrix\` first._"
  else
    emit_table "Manifest lines (3.x / GA)" "${main_list}"
    emit_table "4.x-native lines" "${fourx_list}"
    echo "Legend: :white_check_mark: BUILD SUCCESS · :x: BUILD FAILURE · :warning: unparseable · — no result yet."
    echo
    echo "Variants:"
    for v in "${variants[@]}"; do
      ver=$(awk -v n="${v}" '$1==n {print $2}' "${root}/variants.txt")
      echo "- \`${v}\` = Maven ${ver}"
    done
  fi
} > "${out}"

echo "Wrote ${out} (${#projects[@]} project row(s), ${#variants[@]} variant column(s))."
