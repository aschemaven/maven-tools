#!/bin/bash
set -u -o pipefail

# nightly-summary - one short mail about what the nightly actually did.
#
# WHY
#     The nightly only ever wrote on failure, and then only the stage name.
#     A run that succeeds says nothing at all, so there was no way to see
#     whether it is doing useful work: which repositories moved, how the
#     compatibility matrix fared, whether build or test success drifted.
#
# SYNOPSIS
#     nightly-summary [<cycle-log-dir>]
#
#     Writes plain text to stdout. jqa-nightly pipes it to NIGHTLY_MAIL;
#     run it by hand to see the same thing.
#
# DEGRADES
#     Every section is optional. A machine that has never run the matrix
#     says so instead of inventing numbers.
#
# STATE
#     var/nightly-summary-matrix.tsv remembers the matrix cell states of the
#     previous summary, so drift is computed against our own last run without
#     depending on compat-report's internals.

dir=$(dirname "${0}")
root=$(CDPATH= cd "${dir}/.." && pwd)
# --advance commits the streak snapshot; without it the run is read-only with
# respect to state, so testing or re-reading a summary cannot distort the
# failure gradation.
: "${NSUM_ADVANCE:=false}"
for _a in "$@"; do [[ "${_a}" == "--advance" ]] && NSUM_ADVANCE=true; done

state_dir="${root}/var"
cycle="${1-}"
[[ -n "${cycle}" ]] || cycle=$(ls -1dt "${root}"/logs/jqa-cycle-* 2>/dev/null | head -1)

host=$(hostname -s 2>/dev/null || echo unknown)
status_line=$(cat "${state_dir}/nightly-status.txt" 2>/dev/null || echo "")
outcome=$(printf '%s' "${status_line}" | awk -F'\t' '{print $2" "$3}')

printf 'jQA Nightly  %s  %s\n' "${host}" "$(date '+%F %H:%M')"
printf 'Outcome: %s\n' "${outcome:-unknown}"

# --- stages ---------------------------------------------------------------
# A nightly run is FOUR cycles, one per stage, each with its own log dir and
# its own run id. Reading "the latest cycle" therefore showed only analyze.
# Take the most recent row per stage out of the history instead -- that is
# what a reader wants to see, and it does not depend on how the run was
# chopped into cycles.
hist="${root}/metrics/jqa-timings.tsv"
if [[ -r "${hist}" ]]; then
  printf '\n== Stages ==\n'
  awk -F'\t' -v host="${host}" '
    NR == 1 || $6 != host { next }
    { if ($2 > seen[$3]) { seen[$3] = $2; sec[$3] = $4; rc[$3] = $5 } }
    END {
      split("build scan github analyze", st, " ")
      total = 0
      for (k = 1; k <= 4; k++) {
        g = st[k]
        if (!(g in sec)) continue
        total += sec[g]
        printf "  %-9s %9s  rc=%s   %s\n", g, hms(sec[g]), rc[g], seen[g]
      }
      if (total > 0) printf "  %-9s %9s\n", "total", hms(total)
    }
    function hms(x,  h, m) {
      h = int(x / 3600); m = int((x % 3600) / 60)
      return (h > 0) ? sprintf("%dh%02dm", h, m) : sprintf("%dm%02ds", m, x % 60)
    }
  ' "${hist}"
fi
if [[ -n "${cycle}" && -r "${cycle}/timing.txt" ]]; then
  mvnv=$(awk -F= '/^mvn=/{sub(/^mvn=/,""); print; exit}' "${cycle}/timing.txt")
  [[ -n "${mvnv}" ]] && printf '  maven:    %s\n' "${mvnv}"
fi

# jqa-nightly records the moves with their SHAs at detection time, because it
# overwrites the previous HEADs just before it ends -- diffing the two files
# here would therefore show nothing. Fall back to that diff anyway for a
# summary run by hand between nightlies.
changed_file="${state_dir}/nightly-changed.tsv"
total=$(wc -l < "${state_dir}/nightly-heads.current" 2>/dev/null | tr -d ' ')
printf '\n== Repositories ==\n'
if [[ -r "${changed_file}" ]]; then
  n=$(wc -l < "${changed_file}" | tr -d ' ')
  printf '  %s of %s repositories moved\n' "${n}" "${total:-?}"
  if (( n > 0 )); then
    printf '\n'
    awk -F'\t' '{ printf "  %-42s %s -> %s\n", $1, ($2=="-" ? "NEW     " : substr($2,1,8)), substr($3,1,8) }' \
      "${changed_file}" | head -30
    (( n > 30 )) && printf '  ... and %s more\n' "$((n - 30))"
  fi
elif [[ -r "${state_dir}/nightly-heads.tsv" && -r "${state_dir}/nightly-heads.current" ]]; then
  awk -F'\t' 'NR==FNR{old[$1]=$2; next}
              { if (!($1 in old))     printf "  %-42s NEW      -> %s\n", $1, substr($2,1,8);
                else if (old[$1]!=$2) printf "  %-42s %s -> %s\n", $1, substr(old[$1],1,8), substr($2,1,8) }' \
      "${state_dir}/nightly-heads.tsv" "${state_dir}/nightly-heads.current" > /tmp/nsum-fb.$$ 2>/dev/null || true
  n=$(wc -l < /tmp/nsum-fb.$$ | tr -d ' ')
  printf '  %s of %s repositories moved since the last recorded HEADs\n' "${n}" "${total:-?}"
  (( n > 0 )) && { printf '\n'; head -30 /tmp/nsum-fb.$$; }
  rm -f /tmp/nsum-fb.$$
else
  printf '  no HEAD history recorded yet\n'
fi

# --- matrix ---------------------------------------------------------------
mx="${root}/reports/compat-matrix.md"
printf '\n== Compatibility matrix ==\n'
if [[ -r "${mx}" ]]; then
  gen=$(awk '/^_Generated/{gsub(/[_*]/,""); print; exit}' "${mx}")
  [[ -n "${gen}" ]] && printf '  %s\n' "${gen}"
  printf '\n  Maven versions under test:\n'
  awk '/^- `/{ gsub(/`/,""); sub(/^- /,"  - "); print "  "$0 }' "${mx}" | head -12

  # Cell states straight out of the rendered table. Count OCCURRENCES in
  # table rows only: "grep -c" counts lines, so a row with four green cells
  # counted once, and the legend line -- which names all three markers --
  # added one to every tally.
  read -r ok bad warn < <(awk -F'|' '/^\| `/{
        for (i=3;i<=NF;i++) {
          if ($i ~ /white_check_mark/) o++;
          else if ($i ~ /:x:/)         b++;
          else if ($i ~ /warning/)     w++;
        }
      } END { printf "%d %d %d\n", o, b, w }' "${mx}")
  printf '\n  Cells: %s ok, %s failed, %s unparseable\n' "${ok}" "${bad}" "${warn}"

  # Cell states, keyed by VARIANT NAME -- never by column position. An earlier
  # version wrote "col 3", which told the reader nothing, and keyed the
  # snapshot by it: when the variant set changed (dpv-* and m4-rc5/rc6
  # dropped, m4-41x added) the same index named a DIFFERENT variant on either
  # side, so the mail reported drift that never happened.
  snap="${state_dir}/nightly-summary-matrix.tsv"
  cells="${state_dir}/nightly-summary-cells.tsv"
  cur="/tmp/nsum-cur.$$"
  awk -F'|' '
    # The header carries the variant names; it precedes the rows it labels.
    /^\| Project \|/ {
      if (!have) { for (i=3;i<=NF;i++) { v=$i; gsub(/^ +| +$/,"",v); name[i]=v } have=1 }
      next
    }
    /^\| `/ {
      gsub(/`|  */,"",$2);
      for (i=3;i<=NF;i++) {
        s="?";
        if ($i ~ /white_check_mark/)   s="ok";
        else if ($i ~ /:x:/)           s="fail";
        else if ($i ~ /hourglass/)     s="timeout";
        else if ($i ~ /no_entry_sign/) s="excluded";
        else if ($i ~ /warning/)       s="warn";
        else if ($i ~ /—/)             s="none";
        if (s!="?" && name[i] != "") printf "%s\t%s\t%s\n", $2, name[i], s;
      }
    }' "${mx}" | sort > "${cur}" 2>/dev/null || true

  # Merge with the previous snapshot into one table the renderers share:
  #   project, variant, state, streak, changed, previous-state
  # The streak is how many consecutive summaries the cell has held this state.
  # It is what lets a long-standing failure be told apart from a fresh one --
  # a wall of red says nothing about which cell broke last night.
  # A 3-column snapshot from before this change is read as streak 1.
  awk -F'\t' -v snap="${snap}" '
    BEGIN {
      while ((getline line < snap) > 0) {
        n = split(line, f, "\t")
        if (n >= 3) { k = f[1] "\t" f[2]; old[k] = f[3]; st[k] = (n >= 4 && f[4] > 0 ? f[4] : 1) }
      }
    }
    {
      k = $1 "\t" $2
      if (k in old) {
        if (old[k] == $3) { sk = st[k] + 1; ch = 0 } else { sk = 1; ch = 1 }
        pv = old[k]
      } else { sk = 1; ch = 0; pv = "-" }
      printf "%s\t%s\t%s\t%d\t%d\t%s\n", $1, $2, $3, sk, ch, pv
    }
  ' "${cur}" > "${cells}.$$" 2>/dev/null || true
  mkdir -p "${state_dir}" && mv -f "${cells}.$$" "${cells}" 2>/dev/null || true

  # A snapshot from before the variant-name key held column INDICES in field
  # 2. Comparing the two would pit "1".."6" against variant names: nothing
  # matches, so the drift section would claim "every cell holds its previous
  # state" (nothing was comparable, which is not the same thing) and then list
  # "Variants removed: 1 2 3 4 5 6". Say what actually happened instead.
  snap_is_legacy=false
  if [[ -r "${snap}" ]] \
     && awk -F'\t' '{ tot++; if ($2 != "" && $2 + 0 == $2) num++ } END { exit !(tot > 0 && num == tot) }' "${snap}"; then
    snap_is_legacy=true
  fi

  if [[ "${snap_is_legacy}" == "true" ]]; then
    printf '\n  Drift since the previous summary:\n'
    printf '    not comparable -- the previous snapshot was keyed by column index,\n'
    printf '    this one by variant name. This run becomes the new baseline.\n'
  elif [[ -r "${snap}" ]]; then
    printf '\n  Drift since the previous summary:\n'
    # Regressions first: that is the one thing worth waking up for. A mass of
    # "none -> something" after an invalidation is expected and gets counted,
    # not listed line by line.
    awk -F'\t' '
      $5 != 1 { next }
      {
        proj=$1; var=$2; to=$3; from=$6
        if (from == "ok" && (to == "fail" || to == "warn" || to == "timeout"))
          reg[++nr] = sprintf("      %-42s %-8s %s -> %s", proj, var, from, to)
        else if ((from == "fail" || from == "warn" || from == "timeout") && to == "ok")
          fix[++nf] = sprintf("      %-42s %-8s %s -> %s", proj, var, from, to)
        else if (from == "none") first++
        else if (to == "none")   cleared++
        else if (to == "excluded") excl++
        else oth[++no] = sprintf("      %-42s %-8s %s -> %s", proj, var, from, to)
        n++
      }
      END {
        if (!n) { print "    none -- every cell holds its previous state"; exit }
        if (nr) { print "    REGRESSIONS (ok -> not ok):"; for (i=1;i<=nr;i++) print reg[i] }
        if (nf) { print "    Fixed:";                      for (i=1;i<=nf;i++) print fix[i] }
        if (no) { print "    Other transitions:";          for (i=1;i<=no;i++) print oth[i] }
        if (first)   printf "    First result after invalidation: %d cell(s)\n", first
        if (cleared) printf "    Result cleared (now unknown):    %d cell(s)\n", cleared
        if (excl)    printf "    Now excluded by project-variants: %d cell(s)\n", excl
      }' "${cells}"
    # Long-standing failures, loudest first. A cell failing for weeks is a
    # different problem from one that broke last night, and the plain-text
    # part must say so too -- not only the coloured table.
    awk -F'\t' '
      ($3 == "fail" || $3 == "timeout") && $4 >= 3 { printf "      %-42s %-8s %s for %d summaries\n", $1, $2, $3, $4 | "sort -rn -k4"; n++ }
      END { if (n) print "" }' "${cells}" > /tmp/nsum-long.$$ 2>/dev/null || true
    if [[ -s /tmp/nsum-long.$$ ]]; then
      printf '\n  Failing for three or more summaries:\n'
      sort -t$'\t' -k1,1 /tmp/nsum-long.$$ | head -15
    fi
    rm -f /tmp/nsum-long.$$
    # A changed variant set is a configuration change, not drift.
    gone=$(comm -23 <(cut -f2 "${snap}" | sort -u) <(cut -f2 "${cur}" | sort -u) | tr '\n' ' ')
    new_=$(comm -13 <(cut -f2 "${snap}" | sort -u) <(cut -f2 "${cur}" | sort -u) | tr '\n' ' ')
    [[ -n "${gone// /}" ]] && printf '    Variants removed since then: %s\n' "${gone% }"
    [[ -n "${new_// /}" ]] && printf '    Variants added since then:   %s\n' "${new_% }"
  else
    printf '\n  (no previous summary to compare against; recording this one as the baseline)\n'
  fi
  # The snapshot advances ONLY for a real nightly, which passes --advance.
  # The streak counts summaries, so every ad-hoc run used to bump all of them:
  # three test invocations put every cell at streak 3 and the shading became
  # meaningless. An ad-hoc run still writes the derived cells file (so the HTML
  # renders) but leaves the counter where the nightly left it.
  if [[ "${NSUM_ADVANCE:-false}" == "true" ]]; then
    cut -f1-4 "${cells}" > "${snap}.$$" 2>/dev/null && mv -f "${snap}.$$" "${snap}" 2>/dev/null || true
  fi
  rm -f "${cur}"

  dr="${root}/reports/compat-drift.md"
  if [[ -r "${dr}" ]]; then
    printf '\n  Drift vs the upstream table:\n'
    awk '/^Status mismatches/{gsub(/[*_]/,""); print "    "$0; exit}' "${dr}"
  fi
else
  printf '  No matrix data on this machine yet (reports/compat-matrix.md missing).\n'
  printf '  compat-tick renders it on its next tick; heavy builds only inside\n'
  printf '  its window and never while this nightly holds its lock.\n'
fi

# --- timings: latest per stage, against a ROLLING window -----------------
# A rolling window and not the whole history, and the raw values alongside the
# median. Measured on godestorm: the scan sat at 9 to 10 hours for twelve
# consecutive days and then dropped to 2.2 once the volume was freed. Against
# an all-history median that regime change would be reported as "-78%" for
# weeks after it became the normal case; a window of ten lets it work itself
# in within about five runs.
#
# The raw values are printed because they make an outlier self-explanatory.
# Removing outliers would be worse: the 12-hour night and the 21-hour scan on
# godecane are the evidence that disk pressure costs a factor of six. They
# stay in the data; the window decides what counts as "usual".
: "${TIMING_WINDOW:=10}"
if [[ -r "${hist}" ]]; then
  printf '\n== Timings vs the last %s runs ==\n' "${TIMING_WINDOW}"
  awk -F'\t' -v host="${host}" -v win="${TIMING_WINDOW}" '
    NR == 1 || $6 != host || $5 != 0 { next }
    { key = $3; n[key]++; ts[key, n[key]] = $2; sec[key, n[key]] = $4 }
    END {
      split("build scan github analyze", st, " ")
      printf "  stage      latest    median    delta   recent\n"
      for (k = 1; k <= 4; k++) {
        g = st[k]
        if (!(g in n)) continue
        # Rows arrive in append order, so the tail is the most recent window.
        lo = n[g] - win + 1; if (lo < 1) lo = 1
        cnt = 0
        for (i = n[g]; i >= lo; i--) { cnt++; w[cnt] = sec[g, i] }
        cur = w[1]
        # Median of the window EXCLUDING the latest value, so "latest" is
        # compared against its history rather than against itself.
        c = 0
        for (i = 2; i <= cnt; i++) { c++; h[c] = w[i] }
        m = median(h, c)
        d = (m > 0) ? sprintf("%+d%%", (cur - m) * 100 / m) : "n/a"
        flag = (m > 0 && cur > 1.5 * m) ? " <-" : ""
        recent = ""
        for (i = 1; i <= cnt && i <= 5; i++) recent = recent " " short(w[i])
        printf "  %-9s %8s %9s %8s%s %s\n", g, hms(cur), (m > 0 ? hms(m) : "-"), d, flag, recent
        delete w; delete h
      }
    }
    function hms(x,  h2, m2) {
      h2 = int(x / 3600); m2 = int((x % 3600) / 60)
      return (h2 > 0) ? sprintf("%dh%02dm", h2, m2) : sprintf("%dm", m2)
    }
    function short(x) {
      return (x >= 3600) ? sprintf("%.1fh", x / 3600) : sprintf("%dm", int(x / 60))
    }
    function median(a, c,  i, j, tmp) {
      if (c == 0) return 0
      for (i = 1; i < c; i++) for (j = i + 1; j <= c; j++)
        if (a[j] + 0 < a[i] + 0) { tmp = a[i]; a[i] = a[j]; a[j] = tmp }
      return (c % 2) ? a[(c + 1) / 2] + 0 : int((a[int(c/2)] + a[int(c/2) + 1]) / 2)
    }
  ' "${hist}"

  pt="${root}/metrics/project-timings.tsv"
  if [[ -r "${pt}" ]]; then
    printf '\n  slowest projects recorded most recently:\n'
    tail -400 "${pt}" | awk -F'\t' '$4+0 > 0 { printf "%s\t%s\n", $4, $3 }' \
      | sort -rn | awk -F'\t' '!seen[$2]++' | head -5 \
      | awk -F'\t' '{ printf "    %-44s %dm%02ds\n", $2, int($1/60), $1%60 }'
  fi
fi

# --- graph and disk -------------------------------------------------------
printf '\n== Graph ==\n'
# The scheduled run logs to jqa-nightly.out.log, a hand-started one to its own
# file; take whichever was written last so the figure belongs to this run.
newest_log=$(ls -1t "${root}"/logs/jqa-nightly.out.log "${root}"/logs/nightly-*.log 2>/dev/null | head -1)
nodes=$(grep -oE 'slot [a-z]+ verified: [0-9]+ nodes' "${newest_log:-/dev/null}" 2>/dev/null | tail -1)
[[ -n "${nodes}" ]] && printf '  %s\n' "${nodes}"
slot=$(readlink "${root}/jqassistant/publish/current" 2>/dev/null | sed 's#.*/##')
[[ -n "${slot}" ]] && printf '  serving slot: %s\n' "${slot}"
printf '  stores kept: %s\n' "$(ls -1d "${root}"/jqassistant/store-* 2>/dev/null | wc -l | tr -d ' ')"
printf '\n== Disk ==\n'
df -h "${HOME}" 2>/dev/null | tail -1 | awk '{printf "  %s free of %s (%s used)\n", $4, $2, $5}'
